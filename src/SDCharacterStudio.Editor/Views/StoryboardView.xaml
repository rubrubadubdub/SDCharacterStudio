<UserControl x:Class="SDCharacterStudio.Editor.Views.StoryboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:views="clr-namespace:SDCharacterStudio.Editor.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StoryboardViewModel}"
             PreviewKeyDown="Storyboard_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Beat palette -->
        <Border Grid.Column="0" Background="{StaticResource PanelHeaderBrush}" CornerRadius="0,0,0,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Click to add after the selection, or drag onto a lane." Style="{StaticResource Faint}" FontSize="11" Margin="10,6,8,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Static vm:StoryboardViewModel.Palette}" Margin="6,0,6,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteGroup}">
                                <StackPanel Margin="0,4,0,2">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PanelTitle}" Margin="4,2,0,2"
                                               Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PaletteEntry}">
                                                <Border x:Name="Tile" Tag="palette" CornerRadius="4" Padding="6,4" Margin="0,1" Background="Transparent" Cursor="Hand"
                                                        ToolTip="{Binding Help}"
                                                        MouseLeftButtonDown="Palette_MouseLeftButtonDown" MouseMove="Palette_MouseMove" MouseLeftButtonUp="Palette_MouseLeftButtonUp">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="15" Margin="0,0,7,0" Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Lanes -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,10,2">
                <ToggleButton Content="Branch graph" IsChecked="{Binding GraphMode, Mode=TwoWay}" Padding="10,4" Tag="graph-toggle" />
                <TextBlock Text="Choice and goto links are selectable" Style="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding GraphMode, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
            </StackPanel>
            <views:BranchGraphView DataContext="{Binding}" Visibility="{Binding GraphMode, Converter={StaticResource VisibleWhen}}" />
        <ScrollViewer x:Name="LaneScroller" Style="{StaticResource VisibleScrollViewer}" Visibility="{Binding GraphMode, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="True"
                      FocusVisualStyle="{x:Null}" Background="Transparent">
            <Grid x:Name="LaneCanvasRoot">
            <StackPanel Margin="10,8,10,10">
                <ItemsControl ItemsSource="{Binding Lanes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LaneViewModel}">
                            <Grid Margin="0,0,0,8" Tag="lane" Background="Transparent" AllowDrop="True" DragOver="Lane_DragOver" Drop="Lane_Drop" DragLeave="Lane_DragLeave">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Lane header -->
                                <Border x:Name="Header" Tag="lane-header" Grid.Column="0" CornerRadius="6" Padding="10,7" Margin="0,0,10,0" Background="{StaticResource PanelHeaderBrush}"
                                        BorderThickness="1.5" BorderBrush="Transparent" Cursor="Hand" VerticalAlignment="Stretch"
                                        ContextMenuOpening="Lane_ContextMenuOpening">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}" />
                                    </Border.InputBindings>
                                    <Border.ContextMenu>
                                        <ContextMenu />
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsBranch, Converter={StaticResource VisibleWhen}}">
                                                <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Rename24}" Command="{Binding RenameCommand}" ToolTip="Rename branch" FontSize="12" />
                                                <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" ToolTip="Delete branch" FontSize="12" />
                                            </StackPanel>
                                            <ui:SymbolIcon Symbol="{Binding Converter={x:Static views:StatusIcons.Lane}}" FontSize="15" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding IncomingText}" Style="{StaticResource Faint}" FontSize="11" Margin="0,3,0,0"
                                                   Visibility="{Binding IncomingText, Converter={StaticResource VisibleWhen}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding IsUnreachable, Converter={StaticResource VisibleWhen}}">
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,4,0" />
                                            <TextBlock Text="Unreachable" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Cards -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BeatCardViewModel}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="Card" Tag="card" Width="186" MinHeight="84" CornerRadius="6" Background="{StaticResource CardBrush}"
                                                            BorderThickness="1.5" BorderBrush="{StaticResource SubtleLineBrush}" Cursor="Hand" AllowDrop="True"
                                                            MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                                            DragOver="Card_DragOver" Drop="Card_Drop" DragLeave="Card_DragLeave"
                                                            ContextMenuOpening="Card_ContextMenuOpening">
                                                        <Border.ContextMenu>
                                                            <ContextMenu />
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Border Width="4" HorizontalAlignment="Left" CornerRadius="5,0,0,5" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                            <StackPanel Margin="11,6,8,7">
                                                                <DockPanel>
                                                                    <ui:SymbolIcon DockPanel.Dock="Right" FontSize="15"
                                                                                   Symbol="{Binding HasError, Converter={x:Static views:StatusIcons.Severity}}"
                                                                                   Foreground="{Binding HasError, Converter={StaticResource SeverityBrush}}"
                                                                                   ToolTip="{Binding ProblemText}" Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}" />
                                                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="14" Margin="0,0,6,0" Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                                    <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    </TextBlock>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50" Margin="0,4,0,0" />
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                           Visibility="{Binding HasDetail, Converter={StaticResource VisibleWhen}}" />
                                                                <ItemsControl ItemsSource="{Binding Links}" Margin="0,3,0,0" Visibility="{Binding HasLinks, Converter={StaticResource VisibleWhen}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:CardLink}">
                                                                            <ui:Button Style="{StaticResource LinkButton}" Command="{Binding Go}" ToolTip="{Binding Label}" HorizontalAlignment="Stretch">
                                                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="→" /><Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                </TextBlock>
                                                                            </ui:Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <ui:Button Style="{StaticResource LinkButton}" Command="{Binding GoToCommand}" Margin="0,3,0,0"
                                                                           Visibility="{Binding GoToTarget, Converter={StaticResource VisibleWhen}}">
                                                                    <TextBlock><Run Text="→" /><Run Text="{Binding GoToTarget, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock x:Name="Arrow" Text="›" FontSize="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="5,26,5,0" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#99EFCB4A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#CCE05D5D" />
                                                    </DataTrigger>
                                                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEnd}" Value="True">
                                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Lane end: add + how it ends -->
                                    <StackPanel VerticalAlignment="Top" Margin="2,20,0,0">
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Tag="{Binding}" Click="AddToLane_Click"
                                                   ToolTip="Add a beat at the end of this lane" Appearance="Secondary" Padding="8" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding EndText}" Style="{StaticResource Faint}" FontSize="11" VerticalAlignment="Top" Margin="10,30,0,0" TextWrapping="NoWrap"
                                               Visibility="{Binding EndText, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding HasScene, Converter={StaticResource VisibleWhen}}">
                    <ui:Button Content="New branch" Icon="{ui:SymbolIcon BranchFork24}" Command="{Binding AddBranchInteractiveCommand}" Padding="10,4"
                               ToolTip="A branch is a separate list of beats that a Choice answer or a Go to beat jumps to." />
                    <TextBlock Text="Choices create their branches for you. Delete, Ctrl+D duplicate, Ctrl+←/→ reorder, ←/→ step through beats."
                               Style="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
            <Canvas x:Name="LaneConnections" IsHitTestVisible="False" Panel.ZIndex="5" />
            </Grid>
        </ScrollViewer>
        </DockPanel>

        <TextBlock Grid.Column="1" Text="Open or create a project to build its storyboard." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasScene, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
    </Grid>
</UserControl>
