<UserControl x:Class="SDCharacterStudio.Editor.Views.Studio.CharacterStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:studio="clr-namespace:SDCharacterStudio.Editor.Views.Studio"
             xmlns:lib="clr-namespace:SDCharacterStudio.Editor.Studio"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CharacterStudioViewModel}"
             d:DesignWidth="1400" d:DesignHeight="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/FieldTemplates.xaml" />
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/Studio/StudioTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Editors by item kind -->
            <DataTemplate DataType="{x:Type vm:PoseDocumentViewModel}">
                <studio:PoseEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AnimationDocumentViewModel}">
                <studio:AnimationEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaskDocumentViewModel}">
                <studio:MaskEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RigDocumentViewModel}">
                <studio:RigEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExpressionDocumentViewModel}">
                <studio:ExpressionEditorView />
            </DataTemplate>
            <!-- Portraits use the pose editor (PortraitDocumentViewModel is a PoseDocumentViewModel). -->
            <DataTemplate DataType="{x:Type vm:StudioDocumentViewModel}">
                <Border Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Fields}" IsTabStop="False" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="PersonalItem" DataType="{x:Type vm:PersonalItemViewModel}">
                <Border Background="Transparent" Padding="4,3" CornerRadius="4" ToolTip="{Binding Tooltip}" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding Studio.UseFromMyLibraryCommand}" CommandParameter="{Binding}" />
                    </Border.InputBindings>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Use in this pack" Command="{Binding Studio.UseFromMyLibraryCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <Separator />
                            <MenuItem Header="Delete from My library" Command="{Binding Studio.DeleteFromMyLibraryCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Use" Command="{Binding Studio.UseFromMyLibraryCommand}" CommandParameter="{Binding}"
                                   ToolTip="Copy it into this pack (with its art, masks and rigs)" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,8,0" Background="{StaticResource StageBackdropBrush}" CornerRadius="4">
                            <Image Source="{Binding Thumbnail}" Style="{StaticResource Pixel}" Stretch="Uniform" Margin="1" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Visibility="{Binding InThisPack, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="in this pack" FontSize="10" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="LibraryItem" DataType="{x:Type vm:LibraryItemViewModel}">
                <DockPanel Background="Transparent" ToolTip="{Binding Id, StringFormat='ID: {0}'}">
                    <DockPanel.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                    </DockPanel.InputBindings>
                    <DockPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenCommand}" Icon="{ui:SymbolIcon Open24}" />
                            <MenuItem Header="Duplicate" Command="{Binding Studio.DuplicateCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Copy24}" />
                            <MenuItem Header="{Binding Studio.CopyForLabel}" Command="{Binding Studio.CopyForCharacterCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon PeopleSwap24}"
                                      Visibility="{Binding IsPose, Converter={StaticResource VisibleWhen}}" />
                            <MenuItem Header="Use in the current scene" Command="{Binding Studio.UseInSceneCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon VideoClipMultiple24}"
                                      Visibility="{Binding CanUseInScene, Converter={StaticResource VisibleWhen}}" />
                            <MenuItem Header="Save to My library" Command="{Binding Studio.SaveToMyLibraryCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon BookAdd24}"
                                      Visibility="{Binding CanSaveToMyLibrary, Converter={StaticResource VisibleWhen}}" />
                            <Separator />
                            <MenuItem Header="Delete" Command="{Binding Studio.DeleteCommand}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}" />
                        </ContextMenu>
                    </DockPanel.ContextMenu>
                    <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,8,0" Background="{StaticResource StageBackdropBrush}" CornerRadius="4">
                        <Image Source="{Binding Thumbnail}" Style="{StaticResource Pixel}" Stretch="Uniform" Margin="1" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ToggleButton DockPanel.Dock="Right" Content="Focus canvas" Style="{StaticResource ToolbarToggle}"
                          ToolTip="Hide side panels while painting. Tab on the canvas toggles them back."
                          IsChecked="{Binding Path=(studio:StudioWorkspace.FocusCanvas), RelativeSource={RelativeSource AncestorType=studio:CharacterStudioView}, Mode=TwoWay}" />
            <TextBlock Text="Wheel: zoom · Space + drag: pan · Tab: panels" Style="{StaticResource Faint}" VerticalAlignment="Center" />
        </DockPanel>
    <Grid studio:StudioWorkspace.FocusColumns="0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Character and library ===== -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="CHARACTER" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Character, Delay=1}" ToolTip="Who you're making poses and animations for">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CharacterChoice}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Detail, StringFormat='  ·  {0}'}" Style="{StaticResource Faint}" TextWrapping="NoWrap" VerticalAlignment="Center"
                                                   Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Outfits (D-49): see her in any season, festival or mod outfit the game has. -->
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding Outfits.Count, Converter={StaticResource VisibleWhen}}">
                            <TextBlock DockPanel.Dock="Left" Text="Outfit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Margin="4,0,0,0" Command="{Binding MakeOutfitCommand}"
                                       Visibility="{Binding CanMakeOutfit, Converter={StaticResource VisibleWhen}}"
                                       ToolTip="New outfit: their whole sprite sheet, starting from the outfit shown, to paint clothes on" />
                            <ComboBox ItemsSource="{Binding Outfits}" SelectedItem="{Binding Outfit, Delay=1}" MaxDropDownHeight="420"
                                      ToolTip="See them in another outfit: seasons, festivals (the Flower Dance...) and outfits from mods. Poses stay live: in the game they wear whatever the day gives them, unless a pose always wears one.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OutfitChoice}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding Detail, StringFormat='  ·  {0}'}" Style="{StaticResource Faint}" TextWrapping="NoWrap" VerticalAlignment="Center"
                                                       Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding CharacterFrames}" Margin="0,8,0,0" Height="56" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource StageBackdropBrush}" CornerRadius="4" Margin="0,0,6,0" Padding="2">
                                        <Image Source="{Binding}" Style="{StaticResource Pixel}" Height="52" Stretch="Uniform" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding IsSimple, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Rig…" Command="{Binding MakeRigCommand}"
                                       ToolTip="The rig says where this character's head, neck and face are, and which colours to sample. Made automatically when needed." />
                            <TextBlock Text="{Binding RigStatus}" Style="{StaticResource Faint}" FontSize="11" />
                        </DockPanel>
                        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="5" Background="{StaticResource PanelHeaderBrush}"
                                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                Visibility="{Binding ShowsFashionSenseWarning, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Fashion Sense is installed. Farmer preview uses vanilla parts and does not reproduce Fashion Sense outfits; in-game preview remains available."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,0" HorizontalAlignment="Left">
                    <RadioButton Style="{StaticResource WorkspaceSwitch}" Content="This pack" GroupName="Shelf" IsChecked="{Binding ShowMyLibrary, Converter={StaticResource Not}}"
                                 ToolTip="Poses, animations, masks, rigs, expressions and portraits in this pack" />
                    <RadioButton Style="{StaticResource WorkspaceSwitch}" Content="My library" GroupName="Shelf" IsChecked="{Binding ShowMyLibrary}"
                                 ToolTip="Your own poses and animations, for every project" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
                    <ui:TextBox PlaceholderText="Search poses, animations…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Icon="{ui:SymbolIcon Search24}" />
                    <CheckBox Content="Only this character's items" IsChecked="{Binding OnlyThisCharacter}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- My library -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowMyLibrary, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Margin="8,0,8,8">
                        <TextBlock Style="{StaticResource Caption}" Margin="2,4,2,8"
                                   Text="Save a pose or animation here from its menu (Save to My library). Use copies it into this pack with its art, masks and rigs, so the pack works without the library." />
                        <TextBlock Text="ANIMATIONS" Style="{StaticResource PanelTitle}" Margin="2,4,0,4" />
                        <TextBlock Text="None yet." Style="{StaticResource Faint}" Margin="4,0,0,4" Visibility="{Binding MyAnimations.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                        <ItemsControl ItemsSource="{Binding MyAnimations}" ItemTemplate="{StaticResource PersonalItem}" Focusable="False" />
                        <TextBlock Text="POSES" Style="{StaticResource PanelTitle}" Margin="2,10,0,4" />
                        <TextBlock Text="None yet." Style="{StaticResource Faint}" Margin="4,0,0,4" Visibility="{Binding MyPoses.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                        <ItemsControl ItemsSource="{Binding MyPoses}" ItemTemplate="{StaticResource PersonalItem}" Focusable="False" />
                        <ui:Button Style="{StaticResource LinkButton}" Content="Show the library folder" Command="{Binding ShowMyLibraryFolderCommand}" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowMyLibrary, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="6,0,6,8" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LibrarySectionViewModel}">
                                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,4,0,0" Padding="2" Visibility="{Binding IsShown, Converter={StaticResource VisibleWhen}}">
                                    <Expander.Header>
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" ToolTip="{Binding NewLabel}"
                                                       Command="{Binding NewCommand}" />
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="Nothing yet." Style="{StaticResource Faint}" Margin="6,2"
                                                   Visibility="{Binding Items.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                                        <ListBox ItemsSource="{Binding Items}" ItemTemplate="{StaticResource LibraryItem}" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="List_PreviewMouseWheel">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="Padding" Value="4,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource ThinSplitter}" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <!-- ===== Open items ===== -->
        <Grid Grid.Column="2">
            <TabControl ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}" Padding="0,4,0,0"
                        Visibility="{Binding HasDocuments, Converter={StaticResource VisibleWhen}}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StudioDocumentViewModel}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ItemId, StringFormat='ID: {0}'}">
                            <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss16}" FontSize="10" Padding="3" Margin="6,0,0,0" Command="{Binding CloseCommand}" ToolTip="Close" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <!-- The way back to the scene with what you made, on the tab row's right. -->
            <ui:Button Content="Use in the scene" Icon="{ui:SymbolIcon ArrowRight24}" Appearance="Primary" Command="{Binding UseActiveInSceneCommand}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,4,0" Padding="10,4" ToolTip="{Binding UseActiveInSceneHint}">
                <ui:Button.Visibility>
                    <MultiBinding Converter="{x:Static studio:StudioConverters.AllVisible}">
                        <Binding Path="HasDocuments" />
                        <Binding Path="CanUseActiveInScene" />
                    </MultiBinding>
                </ui:Button.Visibility>
            </ui:Button>

            <!-- Nothing open yet -->
            <Border Style="{StaticResource Panel}" Visibility="{Binding HasDocuments, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="800">
                    <ui:SymbolIcon Symbol="Accessibility24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Character Studio" Style="{StaticResource Heading}" FontSize="22" HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" MaxWidth="520"
                               Text="Make poses, outfits and animations for a character, then use them in any scene. Pick a character on the left, then start something, or double-click an item to open it." />
                    <TextBlock Text="Open or create a project first (File › New project)." Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"
                               Visibility="{Binding HasProject, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" Margin="0,0,0,12" />
                    <!-- What each thing is, in a line: a first-time modder picks by what they want to make. -->
                    <WrapPanel HorizontalAlignment="Center" IsEnabled="{Binding HasProject}">
                        <ui:Button Width="250" Margin="5" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding NewCommand}" CommandParameter="{x:Static lib:LibraryKind.Pose}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Accessibility24" FontSize="22" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="New pose" FontWeight="SemiBold" />
                                    <TextBlock Text="Standing, sitting, waving: drawn over their own sprite, so it still follows sprite mods." Style="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Button>
                        <ui:Button Width="250" Margin="5" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding NewCommand}" CommandParameter="{x:Static lib:LibraryKind.Clip}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="VideoClipMultiple24" FontSize="22" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="New animation" FontWeight="SemiBold" />
                                    <TextBlock Text="Poses one after another (a greeting, a little dance) for a scene to play." Style="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Button>
                        <ui:Button Width="250" Margin="5" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding MakeOutfitCommand}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Grid24" FontSize="22" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="New outfit" FontWeight="SemiBold" />
                                    <TextBlock Text="Their whole sprite sheet with your clothes painted on. Scenes can dress them in it." Style="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Button>
                        <ui:Button Width="250" Margin="5" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding NewCommand}" CommandParameter="{x:Static lib:LibraryKind.Expression}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="EmojiSmileSlight24" FontSize="22" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="New expression" FontWeight="SemiBold" />
                                    <TextBlock Text="A blush, closed eyes or a new mouth, painted over their face in a line of dialogue." Style="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Button>
                        <ui:Button Width="250" Margin="5" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding NewCommand}" CommandParameter="{x:Static lib:LibraryKind.Portrait}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="PersonCircle24" FontSize="22" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="New portrait" FontWeight="SemiBold" />
                                    <TextBlock Text="Their dialogue portrait, one face per emotion, painted over the real one." Style="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Button>
                        <ui:Button Width="250" Margin="5" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding NewEffectCommand}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Sparkle24" FontSize="22" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="New effect" FontWeight="SemiBold" />
                                    <TextBlock Text="A small moving picture (a sweat drop, steam, sparkles) that poses and animations can show." Style="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Button>
                        <ui:Button Width="250" Margin="5" Padding="12,10" HorizontalContentAlignment="Left" Command="{Binding NewCommand}" CommandParameter="{x:Static lib:LibraryKind.Mask}" Visibility="{Binding IsSimple, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CircleHalfFill24" FontSize="22" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel>
                                    <TextBlock Text="New mask" FontWeight="SemiBold" />
                                    <TextBlock Text="Advanced: which pixels of a live layer to keep or hide." Style="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Button>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Faint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Everything you make is for the character picked on the left. When it's ready, Use in the scene (top right) puts it in the cutscene you have open." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
</UserControl>
