<UserControl x:Class="SDCharacterStudio.Editor.Views.Studio.RigEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:studio="clr-namespace:SDCharacterStudio.Editor.Views.Studio"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RigDocumentViewModel}"
             d:DesignWidth="1200" d:DesignHeight="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/FieldTemplates.xaml" />
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/Studio/StudioTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="340" MinWidth="260" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="8,5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource WorkspaceSwitch}" Content="Neck" GroupName="RigTool" ToolTip="Click to place the neck point"
                                         IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Neck}" />
                            <RadioButton Style="{StaticResource WorkspaceSwitch}" Content="Face box" GroupName="RigTool" ToolTip="Drag the box expressions paint into"
                                         IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=FaceBox}" Margin="0,0,10,0" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomOut24}" Click="ZoomOut_Click" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomIn24}" Click="ZoomIn_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Portrait" IsChecked="{Binding Portrait}" ToolTip="The portrait rig: neck, face box and head mask for composed portraits" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding Facings}" Focusable="False" VerticalAlignment="Center"
                                          Visibility="{Binding Portrait, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Style="{StaticResource ToolbarButton}" Content="{Binding}" Click="Facing_Click" Tag="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Facing, StringFormat='· {0}'}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0"
                                       Visibility="{Binding Portrait, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                            <TextBlock Text="{Binding HoverText}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="8,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="10,6" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="Blue = the head mask for this facing. The orange dot is the neck: live heads hang from it. The dashed box is the face box expressions paint into." />
                </Border>
                <Border DockPanel.Dock="Bottom" Background="#33EFCB4A" Padding="10,6" Visibility="{Binding Problems, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Problems}" Style="{StaticResource Caption}" />
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource StageBackdropBrush}" Focusable="False">
                    <studio:PixelCanvas Image="{Binding FrameImage}" Overlay="{Binding Overlay}" OverlayOpacity="0.4" Zoom="{Binding Zoom}" PixelWidth="{Binding Width}" PixelHeight="{Binding Height}"
                                        Anchors="{Binding Anchors}" Selection="{Binding FaceBox}" PixelDown="Canvas_PixelDown" PixelMove="Canvas_PixelMove" PixelUp="Canvas_PixelUp" />
                </ScrollViewer>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Style="{StaticResource ThinSplitter}" HorizontalAlignment="Stretch" ResizeDirection="Columns" />
        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="PROPERTIES" Style="{StaticResource PanelTitle}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Fields}" Margin="12,10,12,12" IsTabStop="False" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
