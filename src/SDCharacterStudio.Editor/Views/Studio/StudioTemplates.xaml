<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
                    xmlns:inf="clr-namespace:SDCharacterStudio.Editor.Infrastructure"
                    xmlns:studio="clr-namespace:SDCharacterStudio.Editor.Views.Studio">

    <!-- A square tool button in the tools panel. -->
    <Style x:Key="StudioTool" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="GroupName" Value="StudioTools" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A folding section header in a panel: a chevron and its title (the chevron turns when open). -->
    <Style x:Key="SectionHeader" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="0,4">
                        <DockPanel>
                            <ui:SymbolIcon x:Name="Chevron" DockPanel.Dock="Left" Symbol="ChevronRight24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                <ui:SymbolIcon.RenderTransform><RotateTransform Angle="0" /></ui:SymbolIcon.RenderTransform>
                            </ui:SymbolIcon>
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource PanelTitle}" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A segment of a toolbar choice (1×, 2×, Game): a toggle that behaves like a radio button. -->
    <Style x:Key="ToolbarToggleRadio" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- The tool rail (D-49): an icon with its key in the corner, like Aseprite and Krita. -->
    <Style x:Key="RailTool" TargetType="RadioButton" BasedOn="{StaticResource StudioTool}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="RailKey" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,-9,-9" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="RailButton" TargetType="ui:Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- List rows whose selection lives in the view model. -->
    <Style x:Key="SelectableRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- One palette swatch: left click = primary colour, right click = secondary. -->
    <DataTemplate x:Key="Swatch" DataType="{x:Type vm:SwatchViewModel}">
        <Border Width="20" Height="20" Margin="0,0,3,3" CornerRadius="3" BorderThickness="1" BorderBrush="#55FFFFFF" Background="{Binding Display}" ToolTip="{Binding Tooltip}" Cursor="Hand">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.PickPrimaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                <MouseBinding Gesture="RightClick" Command="{Binding DataContext.PickSecondaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
            </Border.InputBindings>
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="SwatchPanel">
        <WrapPanel />
    </ItemsPanelTemplate>

    <!-- The palette (doc 07 §6.1): current colours, reserved slots, the character's sampled colours, your colours. -->
    <DataTemplate x:Key="PalettePanel" DataType="{x:Type vm:PaletteViewModel}">
                    <StackPanel>
                        <TextBlock Text="COLOURS" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" HorizontalAlignment="Left" />
                        <DockPanel Margin="0,0,0,8">
                            <Grid Width="44" Height="40" DockPanel.Dock="Left" Margin="0,0,8,0">
                                <Border Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="4" BorderThickness="1" BorderBrush="#88FFFFFF"
                                        Background="{Binding SecondaryBrush}" ToolTip="{Binding SecondaryName, StringFormat='Right button: {0}'}" />
                                <Border Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" BorderThickness="1" BorderBrush="White"
                                        Background="{Binding PrimaryBrush}" ToolTip="{Binding PrimaryName, StringFormat='Left button: {0}'}" />
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding PrimaryName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SecondaryName}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowSwap24}" Command="{Binding SwapCommand}" ToolTip="Swap the colours (X)" />
                                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Eraser24}" Command="{Binding PickTransparentCommand}" ToolTip="Right button paints transparent" />
                                    <ToggleButton x:Name="PickerToggle" Style="{StaticResource ToolbarToggle}" Padding="5,3" IsChecked="{Binding IsPickerOpen}" ToolTip="Mix a colour of your own">
                                        <ui:SymbolIcon Symbol="Color24" />
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <Popup PlacementTarget="{Binding ElementName=PickerToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsPickerOpen}">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                <StackPanel>
                                    <studio:ColorPicker Color="{Binding PickerColor}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right"
                                                Visibility="{Binding IsEditingNamed, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                                        <ui:Button Content="Add to my colours" Command="{Binding AddPickedCommand}" Margin="0,0,6,0" />
                                        <ui:Button Content="Paint with it" Appearance="Primary" Command="{Binding UsePickedCommand}" />
                                    </StackPanel>
                                    <!-- Changing a named colour: everywhere it's painted, as one undo step. -->
                                    <ui:Button Content="{Binding EditingNamedLabel}" Appearance="Primary" Command="{Binding ApplyNamedCommand}" Margin="0,10,0,0" HorizontalAlignment="Right"
                                               Visibility="{Binding IsEditingNamed, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <CheckBox IsChecked="{Binding ShowResolved}" Visibility="{Binding Simple, Converter={StaticResource VisibleWhen}, ConverterParameter=not}"
                                  ToolTip="Slot swatches show what each reserved colour becomes for the chosen character. You still paint the slot colour.">
                            <TextBlock Text="Show the character's real colours" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding SlotsTitle}" Style="{StaticResource Caption}" Margin="0,8,0,4" TextWrapping="Wrap"
                                   ToolTip="Paint with these and they become the character's real skin, hair, clothes... in the game, following sprite mods." />
                        <ItemsControl ItemsSource="{Binding VisibleSlots}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource SwatchPanel}" Focusable="False" />
                        <StackPanel Visibility="{Binding Simple, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                            <TextBlock Text="{Binding SampledFrom, StringFormat='Sampled from {0} (fixed colours)'}" Style="{StaticResource Caption}" Margin="0,8,0,4"
                                       Visibility="{Binding Sampled.Count, Converter={StaticResource VisibleWhen}}" />
                            <ItemsControl ItemsSource="{Binding Sampled}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource SwatchPanel}" Focusable="False" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding InPicture.Count, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="In this picture" Style="{StaticResource Caption}" Margin="0,8,0,4"
                                       ToolTip="Every colour in the frame. The character's own colours paint as their colours, so they follow outfits." />
                            <ItemsControl ItemsSource="{Binding InPicture}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource SwatchPanel}" Focusable="False" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Recent.Count, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Recent" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource SwatchPanel}" Focusable="False" />
                        </StackPanel>
                        <DockPanel Margin="0,8,0,4">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCustomCommand}" ToolTip="Add a colour by its hex code" />
                            <TextBlock Text="Your colours" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Custom}" ItemsPanel="{StaticResource SwatchPanel}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SwatchViewModel}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Swatch}">
                                        <ContentPresenter.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove colour" Command="{Binding PlacementTarget.Tag.RemoveCustomCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </ContentPresenter.ContextMenu>
                                        <ContentPresenter.Tag>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </ContentPresenter.Tag>
                                    </ContentPresenter>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Named colours: paint with them, change them later everywhere (Pixelorama's indexed colours, made simple). -->
                        <DockPanel Margin="0,8,0,4">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddNamedCommand}"
                                       ToolTip="Name the left colour (e.g. Coat): you get a dark, mid and light to paint with, and can change them later everywhere at once" />
                            <TextBlock Text="Named colours" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       ToolTip="Change a named colour (the pencil) and every picture painted with it changes: every frame of every outfit and pose." />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Named}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NamedColorRowViewModel}">
                                    <DockPanel Margin="0,0,0,2" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Change it everywhere…" Command="{Binding PlacementTarget.Tag.EditNamedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Forget the name (the paint stays)" Command="{Binding PlacementTarget.Tag.ForgetNamedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Edit24}" ToolTip="Change it everywhere it's painted"
                                                   Command="{Binding DataContext.EditNamedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Shades}" ItemsPanel="{StaticResource SwatchPanel}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SwatchViewModel}">
                                                    <Border Width="20" Height="20" Margin="0,0,3,3" CornerRadius="3" BorderThickness="1" BorderBrush="#55FFFFFF" Background="{Binding Display}" ToolTip="{Binding Tooltip}" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.PickPrimaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}" />
                                                            <MouseBinding Gesture="RightClick" Command="{Binding DataContext.PickSecondaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}" />
                                                            <MouseBinding Gesture="Shift+LeftClick" Command="{Binding DataContext.EditNamedShadeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0,0,3" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Left click a swatch for the left button, right click for the right. Hold Alt on the canvas to pick a colour." />
                    </StackPanel>
    </DataTemplate>

    <!-- A frame in the strip: thumbnail, number, duration, sequence badges. -->
    <DataTemplate x:Key="FrameThumb" DataType="{x:Type vm:PoseFrameItem}">
        <StackPanel Width="64" Margin="2">
            <!-- An outfit's groups: "Walking down" over the first frame of each. -->
            <TextBlock Text="{Binding Group}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" Margin="0,0,0,1"
                       Visibility="{Binding Document.IsSheet, Converter={StaticResource VisibleWhen}}" />
            <!-- What the frame does when it plays: once (amber), loop (green), end (violet). -->
            <Border Height="4" CornerRadius="2" Margin="0,0,0,2" Background="{Binding Role, Converter={x:Static studio:StudioConverters.RoleBrush}}"
                    ToolTip="{Binding Role, Converter={x:Static studio:StudioConverters.RoleText}}" />
            <Border Height="64" Background="{StaticResource StageBackdropBrush}" CornerRadius="3" BorderThickness="2"
                    BorderBrush="{Binding IsSelected, Converter={x:Static studio:StudioConverters.CurrentFrameBrush}}">
                <Image Source="{Binding Thumbnail}" Style="{StaticResource Pixel}" Stretch="Uniform" Margin="2" />
            </Border>
            <DockPanel Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="SemiBold" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBox Text="{Binding Duration, UpdateSourceTrigger=LostFocus, StringFormat=0}" FontSize="11" Padding="2,0" MinHeight="0" MinWidth="0"
                         inf:Behaviors.CommitOnEnter="True" inf:Behaviors.SelectAllOnFocus="True" ToolTip="How long this frame shows, in milliseconds"
                         Visibility="{Binding ShowsDuration, Converter={StaticResource VisibleWhen}}" />
            </DockPanel>
            <!-- Linked frames: a chain in the group's colour. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Binding LinkText}" Visibility="{Binding IsLinked, Converter={StaticResource VisibleWhen}}">
                <ui:SymbolIcon Symbol="Link24" FontSize="11" Foreground="{Binding LinkColor}" />
                <Border Width="20" Height="3" CornerRadius="1.5" Margin="3,0,0,0" VerticalAlignment="Center" Background="{Binding LinkColor}" />
            </StackPanel>
            <TextBlock Text="{Binding Badges}" Style="{StaticResource Faint}" FontSize="10" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- Intro / Loop / Outro: the order frames play in (doc 03 §10). -->
    <DataTemplate x:Key="SequenceChips" DataType="{x:Type vm:SequenceChip}">
        <Border Style="{StaticResource Chip}" Margin="0,0,3,0" Cursor="Hand" ToolTip="Click to take this frame out of the sequence">
            <TextBlock Text="{Binding Text}" FontSize="11" />
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.RemoveFromSequenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </Border.InputBindings>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Sequences" DataType="{x:Type vm:PoseDocumentViewModel}">
        <WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <ui:Button Style="{StaticResource LinkButton}" Content="Intro +" Command="{Binding AddToIntroCommand}" ToolTip="Play this frame once at the start" />
                <ItemsControl ItemsSource="{Binding Intro}" ItemTemplate="{StaticResource SequenceChips}" ItemsPanel="{StaticResource SwatchPanel}" VerticalAlignment="Center" Focusable="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <ui:Button Style="{StaticResource LinkButton}" Content="Loop +" Command="{Binding AddToLoopCommand}" ToolTip="Repeat this frame while the pose holds" />
                <ItemsControl ItemsSource="{Binding Loop}" ItemTemplate="{StaticResource SequenceChips}" ItemsPanel="{StaticResource SwatchPanel}" VerticalAlignment="Center" Focusable="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ui:Button Style="{StaticResource LinkButton}" Content="Outro +" Command="{Binding AddToOutroCommand}" ToolTip="Play this frame once when the pose ends" />
                <ItemsControl ItemsSource="{Binding Outro}" ItemTemplate="{StaticResource SequenceChips}" ItemsPanel="{StaticResource SwatchPanel}" VerticalAlignment="Center" Focusable="False" />
            </StackPanel>
        </WrapPanel>
    </DataTemplate>

    <!-- A row of the layers panel. -->
    <DataTemplate x:Key="LayerRow" DataType="{x:Type vm:LayerRowViewModel}">
        <DockPanel>
            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsVisible}" ToolTip="Show or hide" VerticalAlignment="Center" MinWidth="0" Margin="0,0,2,0" />
            <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsLocked}" Style="{StaticResource ToolbarToggle}" Padding="3" ToolTip="Lock: stop drawing on this layer by accident" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="LockClosed16" FontSize="12" />
            </ToggleButton>
            <Border DockPanel.Dock="Left" Width="30" Height="30" Margin="4,0,8,0" Background="{StaticResource StageBackdropBrush}" CornerRadius="3">
                <Image Source="{Binding Thumbnail}" Style="{StaticResource Pixel}" Stretch="Uniform" />
            </Border>
            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="{Binding TypeIcon}" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                <WrapPanel>
                    <Border Style="{StaticResource Chip}" Margin="0,2,3,0" Visibility="{Binding MaskChip, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding MaskChip, StringFormat='mask {0}'}" FontSize="10" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,2,3,0" Visibility="{Binding AnchorChip, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding AnchorChip, StringFormat='on {0}'}" FontSize="10" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,2,3,0" Visibility="{Binding HasSlots, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="slots" FontSize="10" />
                    </Border>
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
