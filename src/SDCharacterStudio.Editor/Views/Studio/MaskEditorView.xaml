<UserControl x:Class="SDCharacterStudio.Editor.Views.Studio.MaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:studio="clr-namespace:SDCharacterStudio.Editor.Views.Studio"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MaskDocumentViewModel}"
             d:DesignWidth="1200" d:DesignHeight="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/FieldTemplates.xaml" />
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/Studio/StudioTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid studio:StudioWorkspace.FocusColumns="0,2,3" PreviewKeyDown="View_PreviewKeyDown" PreviewKeyUp="View_PreviewKeyUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="280" MinWidth="230" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,6,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="TOOLS" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource StudioTool}" ToolTip="Brush (B): add pixels to the mask (right button removes)"
                                     IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Brush}">
                            <ui:SymbolIcon Symbol="Edit24" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource StudioTool}" ToolTip="Eraser (E): remove pixels from the mask"
                                     IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Eraser}">
                            <ui:SymbolIcon Symbol="Eraser24" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource StudioTool}" ToolTip="Wand (W): add touching pixels of a similar colour (Shift or right button subtracts)"
                                     IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Wand}">
                            <ui:SymbolIcon Symbol="Wand24" />
                        </RadioButton>
                    </WrapPanel>
                    <TextBlock Text="{Binding WandTolerance, StringFormat='Wand tolerance {0}'}" Style="{StaticResource Caption}" Margin="0,8,0,2" />
                    <Slider Minimum="0" Maximum="64" Value="{Binding WandTolerance}" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <CheckBox Content="Wand: every matching pixel" IsChecked="{Binding WandGlobal}" />

                    <TextBlock Text="SHAPE" Style="{StaticResource PanelTitle}" Margin="0,14,0,6" />
                    <ui:Button Content="Above the neck line" Command="{Binding AboveNeckCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4" ToolTip="Keep everything at or above the rig's neck point" />
                    <UniformGrid Columns="2">
                        <ui:Button Content="Grow" Command="{Binding GrowCommand}" Margin="0,0,2,4" HorizontalAlignment="Stretch" ToolTip="One pixel bigger" />
                        <ui:Button Content="Shrink" Command="{Binding ShrinkCommand}" Margin="2,0,0,4" HorizontalAlignment="Stretch" ToolTip="One pixel smaller" />
                        <ui:Button Content="Invert" Command="{Binding InvertCommand}" Margin="0,0,2,4" HorizontalAlignment="Stretch" />
                        <ui:Button Content="Clear" Command="{Binding ClearMaskCommand}" Margin="2,0,0,4" HorizontalAlignment="Stretch" />
                    </UniformGrid>
                    <ui:Button Content="Mirrored copy" Command="{Binding CopyMirroredCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4" ToolTip="Make the …-right mask from a …-left one (or the other way)" />

                    <TextBlock Text="THIS FRAME" Style="{StaticResource PanelTitle}" Margin="0,14,0,6" />
                    <TextBlock Text="{Binding FrameText}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <ui:Button Content="Give it its own mask" Command="{Binding MakeOverrideCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                               Visibility="{Binding HasOverride, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" ToolTip="For a frame where the head moves (a walk bob)" />
                    <ui:Button Content="Use the main mask" Command="{Binding RemoveOverrideCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                               Visibility="{Binding HasOverride, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="8,5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Grid" IsChecked="{Binding ShowGrid}" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomOut24}" Click="ZoomOut_Click" ToolTip="Zoom out (wheel or Ctrl+-)" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Content="Fit" Click="Fit_Click" ToolTip="Fit the frame (Ctrl+0)" />
                            <TextBlock Text="{Binding Zoom, Converter={x:Static studio:StudioConverters.ZoomText}}" Style="{StaticResource Caption}" VerticalAlignment="Center" MinWidth="28" TextAlignment="Center" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomIn24}" Click="ZoomIn_Click" ToolTip="Zoom in (wheel or Ctrl+=)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="4,0,12,0" />
                            <TextBlock Text="{Binding HoverText}" Style="{StaticResource Faint}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Fit check -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Check again" Command="{Binding RenderFitCommand}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="Fit check: every installed variant of this character (vanilla and mod sprites), what the mask keeps, and an open pose that uses it." />
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Fit}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FitVariant}">
                                        <Border Style="{StaticResource Chip}" Padding="8,6" Margin="0,0,8,0" CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{StaticResource StageBackdropBrush}" Margin="0,0,4,0" Padding="2">
                                                        <Image Source="{Binding Frame}" Style="{StaticResource Pixel}" Height="96" ToolTip="The variant's frame" />
                                                    </Border>
                                                    <Border Background="{StaticResource StageBackdropBrush}" Margin="0,0,4,0" Padding="2">
                                                        <Image Source="{Binding Kept}" Style="{StaticResource Pixel}" Height="96" ToolTip="What the mask keeps" />
                                                    </Border>
                                                    <Border Background="{StaticResource StageBackdropBrush}" Padding="2" Visibility="{Binding OverPose, Converter={StaticResource VisibleWhen}}">
                                                        <Image Source="{Binding OverPose}" Style="{StaticResource Pixel}" Height="96" ToolTip="The open pose drawn with this variant" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,4,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}" FontSize="10" MaxWidth="240" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="#33EFCB4A" Padding="10,6" Visibility="{Binding Problems, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Problems}" Style="{StaticResource Caption}" />
                </Border>

                <ScrollViewer x:Name="CanvasScroller" PreviewMouseDown="Scroller_PreviewMouseDown" PreviewMouseMove="Scroller_PreviewMouseMove" PreviewMouseUp="Scroller_PreviewMouseUp" LostMouseCapture="Scroller_LostMouseCapture" PreviewMouseWheel="Canvas_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource StageBackdropBrush}" Focusable="False">
                    <studio:PixelCanvas x:Name="Canvas" Image="{Binding FrameImage}" Overlay="{Binding Overlay}" OverlayOpacity="0.55" Zoom="{Binding Zoom}"
                                        PixelWidth="{Binding Width}" PixelHeight="{Binding Height}" ShowGrid="{Binding ShowGrid}"
                                        PixelDown="Canvas_PixelDown" PixelMove="Canvas_PixelMove" PixelUp="Canvas_PixelUp" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="2" Style="{StaticResource ThinSplitter}" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <Border Grid.Column="3" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="PROPERTIES" Style="{StaticResource PanelTitle}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Fields}" Margin="12,10,12,12" IsTabStop="False" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
