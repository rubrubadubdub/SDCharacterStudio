<UserControl x:Class="SDCharacterStudio.Editor.Views.Studio.ExpressionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:studio="clr-namespace:SDCharacterStudio.Editor.Views.Studio"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ExpressionDocumentViewModel}"
             d:DesignWidth="1200" d:DesignHeight="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/FieldTemplates.xaml" />
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/Studio/StudioTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid studio:StudioWorkspace.FocusColumns="0,2,3" PreviewKeyDown="View_PreviewKeyDown" PreviewKeyUp="View_PreviewKeyUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="280" MinWidth="230" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,6,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="TOOLS" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource StudioTool}" ToolTip="Pencil (B)" IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Pencil}">
                            <ui:SymbolIcon Symbol="Edit24" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource StudioTool}" ToolTip="Eraser (E): take back your paint" IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Eraser}">
                            <ui:SymbolIcon Symbol="Eraser24" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource StudioTool}" ToolTip="Fill (G)" IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Fill}">
                            <ui:SymbolIcon Symbol="PaintBucket24" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource StudioTool}" ToolTip="Colour picker (I or Alt+click)" IsChecked="{Binding Tool, Converter={x:Static studio:StudioConverters.EnumIs}, ConverterParameter=Picker}">
                            <ui:SymbolIcon Symbol="Eyedropper24" />
                        </RadioButton>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Paint anywhere on the face. Alt+click takes a colour from it. To close the eyes, paint over them with the skin, or remove the face's own pixels first." />
                    <ui:Button Content="Remove pixels" Icon="{ui:SymbolIcon Eraser24}" Command="{Binding RemoveHerPixelsCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                               ToolTip="Paint with Erase: it removes the face's own pixels where you paint (the Eraser tool only takes back your own paint)." />
                    <ContentControl Content="{Binding Palette}" ContentTemplate="{StaticResource PalettePanel}" Margin="0,12,0,0" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="8,5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Grid" IsChecked="{Binding ShowGrid}" />
                            <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Slot colours" IsChecked="{Binding RawSlots}" ToolTip="Show slot colours as painted" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomOut24}" Click="ZoomOut_Click" ToolTip="Zoom out (wheel or Ctrl+-)" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Content="Fit" Click="Fit_Click" ToolTip="Fit the frame (Ctrl+0)" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomIn24}" Click="ZoomIn_Click" ToolTip="Zoom in (wheel or Ctrl+=)" />
                        </StackPanel>
                        <TextBlock Text="{Binding HoverText}" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="4,0" />
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,8,0">
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddFrameCommand}" ToolTip="Add a frame (a copy), for a blink or a twitch" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteFrameCommand}"
                                       ToolTip="Delete this frame, or every frame you picked (Shift or Ctrl+click). Delete key too." />
                        </StackPanel>
                        <ListBox x:Name="FramesList" ItemsSource="{Binding Frames}" SelectedIndex="{Binding FrameIndex}" Background="Transparent" BorderThickness="0"
                                 SelectionMode="Extended" SelectionChanged="Frames_SelectionChanged" KeyDown="Frames_KeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExpressionFrameItem}">
                                    <StackPanel Width="64" Margin="2">
                                        <Border Height="64" Background="{StaticResource StageBackdropBrush}" CornerRadius="3">
                                            <Image Source="{Binding Thumbnail}" Style="{StaticResource Pixel}" Stretch="Uniform" Margin="2" />
                                        </Border>
                                        <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Faint}" FontSize="10" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Background="#33EFCB4A" Padding="10,6" Visibility="{Binding Problems, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Problems}" Style="{StaticResource Caption}" />
                </Border>
                <ScrollViewer x:Name="CanvasScroller" PreviewMouseDown="Scroller_PreviewMouseDown" PreviewMouseMove="Scroller_PreviewMouseMove" PreviewMouseUp="Scroller_PreviewMouseUp" LostMouseCapture="Scroller_LostMouseCapture" PreviewMouseWheel="Canvas_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource StageBackdropBrush}" Focusable="False">
                    <studio:PixelCanvas x:Name="Canvas" Image="{Binding Composite}" Zoom="{Binding Zoom}" PixelWidth="{Binding Width}" PixelHeight="{Binding Height}" ShowGrid="{Binding ShowGrid}"
                                        Selection="{Binding FaceBox}" PixelDown="Canvas_PixelDown" PixelMove="Canvas_PixelMove" PixelUp="Canvas_PixelUp" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="2" Style="{StaticResource ThinSplitter}" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <Border Grid.Column="3" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="PROPERTIES" Style="{StaticResource PanelTitle}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Fields}" Margin="12,10,12,12" IsTabStop="False" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
