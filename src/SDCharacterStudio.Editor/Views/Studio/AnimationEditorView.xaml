<UserControl x:Class="SDCharacterStudio.Editor.Views.Studio.AnimationEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:studio="clr-namespace:SDCharacterStudio.Editor.Views.Studio"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AnimationDocumentViewModel}"
             d:DesignWidth="1200" d:DesignHeight="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/FieldTemplates.xaml" />
                <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/Studio/StudioTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="340" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="300" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- Transport and stage options -->
                <Border Grid.Row="0" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="8,5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsRecording}" Visibility="{Binding ShowsTimeline, Converter={StaticResource VisibleWhen}}"
                                          ToolTip="Record: dragging an actor on the stage makes a position key at the playhead">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource ErrorBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Record" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Mirror" IsChecked="{Binding PreviewMirror}" Visibility="{Binding IsLibrary, Converter={StaticResource VisibleWhen}}"
                                          ToolTip="Preview it flipped left to right, like a Clip beat's Mirror" />
                            <ToggleButton Style="{StaticResource ToolbarToggle}" Content="Loop" IsChecked="{Binding LoopPreview}" ToolTip="Keep playing from the start" />
                            <Rectangle Width="1" Height="18" Fill="{StaticResource SubtleLineBrush}" Margin="6,0" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomOut24}" Click="StageZoomOut_Click" ToolTip="Smaller stage" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomIn24}" Click="StageZoomIn_Click" ToolTip="Bigger stage" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon Previous24}" Command="{Binding RewindCommand}" ToolTip="Back to the start" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Command="{Binding TogglePlayCommand}" ToolTip="Play or pause (Space)">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="{Binding IsPlaying, Converter={x:Static studio:StudioConverters.PlayIcon}}" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,12,0" TextWrapping="NoWrap" />
                            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon AddCircle24}" Content="Key" Command="{Binding AddKeyAtPlayheadCommand}" Visibility="{Binding ShowsTimeline, Converter={StaticResource VisibleWhen}}"
                                       ToolTip="Add a key at the playhead on the selected row (or double-click any row)" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Preview stage -->
                <Grid Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource StageBackdropBrush}" Focusable="False">
                        <studio:ClipStage x:Name="Stage" Actors="{Binding StageActors}" TilesWide="{Binding StageWidth}" TilesHigh="{Binding StageHeight}" Zoom="{Binding StageZoom}"
                                          Recording="{Binding IsRecording}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
                    </ScrollViewer>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="10,6" CornerRadius="6" Background="#CC15171A"
                            Visibility="{Binding StageHint, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding StageHint}" Style="{StaticResource Caption}" MaxWidth="520" />
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="2" Style="{StaticResource ThinSplitter}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

                <!-- Flipbook (D-48): steps left to right, each a pose, a walk or their own look, for a time. -->
                <DockPanel Grid.Row="3" Visibility="{Binding IsFlipbook, Converter={StaticResource VisibleWhen}}">
                    <TextBlock DockPanel.Dock="Bottom" Margin="10,2,10,6" Style="{StaticResource Faint}" TextWrapping="NoWrap"
                               Text="{Binding FlipbookLength, StringFormat='{}{0} · steps play left to right · the stage shows it as it plays'}" />
                    <ScrollViewer Style="{StaticResource VisibleScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlipbookStepViewModel}">
                                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" CornerRadius="6"
                                                Width="230" Margin="0,0,8,0" Padding="10,6" VerticalAlignment="Top">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding EarlierCommand}" ToolTip="Move earlier" />
                                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ChevronRight24}" Command="{Binding LaterCommand}" ToolTip="Move later" />
                                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" ToolTip="Delete this step" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Number, StringFormat='Step {0}'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock Text="Does" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="58" />
                                                    <ComboBox ItemsSource="{x:Static vm:AnimationDocumentViewModel.StepKinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Do, Delay=1}" />
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock Text="Seconds" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="58" />
                                                    <ui:NumberBox Value="{Binding Seconds, Mode=TwoWay}" Minimum="0.05" Maximum="60" SmallChange="0.1" MaxDecimalPlaces="2" ClearButtonEnabled="False" />
                                                </DockPanel>
                                                <StackPanel Visibility="{Binding IsPose, Converter={StaticResource VisibleWhen}}">
                                                    <DockPanel Margin="0,6,0,0">
                                                        <TextBlock Text="Pose" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="58" />
                                                        <ComboBox ItemsSource="{Binding DataContext.PoseChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Pose, Delay=1}"
                                                                  ToolTip="Their poses, then the ready-made ones (made for them the first time you pick one). Make your own in the Poses shelf." />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <TextBlock Text="Plays" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="58" />
                                                        <ComboBox ItemsSource="{x:Static vm:AnimationDocumentViewModel.PlayChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Play, Delay=1}" />
                                                    </DockPanel>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsWalk, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding WalkToCommand}" CommandParameter="left" ToolTip="Walk left" />
                                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding WalkToCommand}" CommandParameter="up" ToolTip="Walk up" />
                                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding WalkToCommand}" CommandParameter="down" ToolTip="Walk down" />
                                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding WalkToCommand}" CommandParameter="right" ToolTip="Walk right" />
                                                        <TextBlock Text="{Binding WalkDirection}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <TextBlock Text="Tiles" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="58" />
                                                        <ui:NumberBox Value="{Binding Distance, Mode=TwoWay}" Minimum="1" Maximum="40" SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
                                                    </DockPanel>
                                                </StackPanel>
                                                <DockPanel Margin="0,6,0,0" Visibility="{Binding HasFacing, Converter={StaticResource VisibleWhen}}">
                                                    <TextBlock Text="Facing" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="58" />
                                                    <ComboBox ItemsSource="{x:Static vm:AnimationDocumentViewModel.FacingChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Facing, Delay=1}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Content="Add step" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddStepCommand}" VerticalAlignment="Top" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                <Border Grid.Row="3" Padding="16" Visibility="{Binding IsTimelineInSimple, Converter={StaticResource VisibleWhen}}">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="This animation was made on the timeline." FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Text="Edit it on the timeline (Advanced), or start it again as a flipbook: a row of steps, each a pose, a walk or their own look, for a time." />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Start over as a flipbook" Appearance="Primary" Command="{Binding StartFlipbookCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Open the timeline" Command="{Binding OpenTimelineCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Timeline -->
                <DockPanel Grid.Row="3" Visibility="{Binding ShowsTimeline, Converter={StaticResource VisibleWhen}}">
                    <DockPanel DockPanel.Dock="Bottom" Margin="8,2,8,4">
                        <Slider DockPanel.Dock="Right" Width="140" Minimum="0.02" Maximum="0.8" Value="{Binding TimelineScale}" ToolTip="Timeline zoom" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="Click to scrub · drag a key to move it · double-click a row to add a key · drag the yellow end to change the length · Delete removes the key" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <studio:TimelineCanvas x:Name="Timeline" Rows="{Binding Rows}" Duration="{Binding Duration, Mode=OneWay}" Playhead="{Binding Playhead}" Scale="{Binding TimelineScale}"
                                               Version="{Binding TimelineVersion}" StepFps="{Binding StepFps, Mode=OneWay}" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource ThinSplitter}" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelHeaderBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                    <TextBlock Text="PROPERTIES" Style="{StaticResource PanelTitle}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Fields}" Margin="12,10,12,12" IsTabStop="False" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
