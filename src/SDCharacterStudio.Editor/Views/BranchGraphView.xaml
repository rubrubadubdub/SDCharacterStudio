<UserControl x:Class="SDCharacterStudio.Editor.Views.BranchGraphView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="6,2">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Selection" Padding="8,3" Margin="0,0,4,0" Click="Selection_Click" ToolTip="Show the selected beat at readable size" />
        <Button Content="Fit" Padding="10,3" Click="Fit_Click" />
      </StackPanel>
      <TextBlock Text="Drag to pan · wheel to zoom · dashed arrows return to a caller" Foreground="LightGray" VerticalAlignment="Center" FontSize="11" />
    </DockPanel>
    <TextBlock x:Name="Diagnostics" DockPanel.Dock="Bottom" Foreground="Orange" FontSize="11" TextWrapping="Wrap" MaxHeight="36" Margin="6,2" />
    <Border x:Name="Viewport" Background="#10141B" ClipToBounds="True" MouseWheel="Canvas_MouseWheel" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp" LostMouseCapture="Viewport_LostMouseCapture">
      <Canvas x:Name="GraphCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Border>
  </DockPanel>
</UserControl>
