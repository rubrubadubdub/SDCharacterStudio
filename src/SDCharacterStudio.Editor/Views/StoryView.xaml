<UserControl x:Class="SDCharacterStudio.Editor.Views.StoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:inf="clr-namespace:SDCharacterStudio.Editor.Infrastructure"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StoryViewModel}">
    <!-- The Story panel (D-51): every story flag and number, where it's set and where it's checked. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="10,8,10,4" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StoryEntryViewModel}">
                        <Border x:Name="Card" CornerRadius="6" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1"
                                Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="Icon" Symbol="Flag24" FontSize="18" Foreground="#FF7FE0A8" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Id, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11.5" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                    <TextBlock x:Name="WarningText" Text="{Binding Warning}" Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding HasWarning, Converter={StaticResource VisibleWhen}}" />
                                    <DockPanel Margin="0,5,0,0" Visibility="{Binding HasSets, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding SetsTitle}" Style="{StaticResource Faint}" Width="78" Margin="0,4,0,0" />
                                        <ItemsControl ItemsSource="{Binding Sets}" IsTabStop="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StoryPlace}">
                                                    <ui:Button Content="{Binding Text}" Command="{Binding Go}" Padding="8,2" Margin="0,0,6,4" FontSize="12" ToolTip="Go there" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                    <DockPanel Margin="0,2,0,0" Visibility="{Binding HasChecks, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock DockPanel.Dock="Left" Text="Checked in" Style="{StaticResource Faint}" Width="78" Margin="0,4,0,0" />
                                        <ItemsControl ItemsSource="{Binding Checks}" IsTabStop="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StoryPlace}">
                                                    <ui:Button Content="{Binding Text}" Command="{Binding Go}" Padding="8,2" Margin="0,0,6,4" FontSize="12" ToolTip="Go there" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </StackPanel>
                                <ui:TextBox Grid.Column="2" Text="{Binding Note, UpdateSourceTrigger=LostFocus}" PlaceholderText="A note: what it means" Margin="12,0,0,0"
                                            VerticalAlignment="Top" TextWrapping="Wrap" ClearButtonEnabled="False" inf:Behaviors.CommitOnEnter="True" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNumber}" Value="True">
                                <Setter TargetName="Icon" Property="Symbol" Value="NumberSymbol24" />
                                <Setter TargetName="Icon" Property="Foreground" Value="#FF3FC1C9" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                <Setter TargetName="WarningText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" Margin="16" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Visibility="{Binding EmptyText, Converter={StaticResource VisibleWhen}}" />
    </Grid>
</UserControl>
