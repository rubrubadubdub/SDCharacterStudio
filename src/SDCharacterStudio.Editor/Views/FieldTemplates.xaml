<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
                    xmlns:views="clr-namespace:SDCharacterStudio.Editor.Views"
                    xmlns:inf="clr-namespace:SDCharacterStudio.Editor.Infrastructure">

    <!-- Label (with help), the editor, then any problem for this field. -->
    <Style x:Key="FieldFrame" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <DockPanel Visibility="{Binding HasLabel, Converter={StaticResource VisibleWhen}}">
                            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Info24" FontSize="12" Margin="4,0,0,3" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" ToolTip="{Binding Help}"
                                           Visibility="{Binding Help, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" ToolTip="{Binding Help}" />
                        </DockPanel>
                        <ContentPresenter />
                        <TextBlock Text="{Binding Problem}" Style="{StaticResource ProblemText}" Foreground="{Binding ProblemIsError, Converter={StaticResource SeverityBrush}}"
                                   Visibility="{Binding Problem, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldNumber" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
        <Setter Property="MaxDecimalPlaces" Value="0" />
        <Setter Property="SpinButtonPlacementMode" Value="Inline" />
        <Setter Property="ClearButtonEnabled" Value="False" />
        <Setter Property="inf:Behaviors.SelectAllOnFocus" Value="True" />
        <Setter Property="inf:Behaviors.CommitOnEnter" Value="True" />
        <Setter Property="MinWidth" Value="90" />
    </Style>

    <DataTemplate DataType="{x:Type vm:SectionField}">
        <StackPanel Margin="0,10,0,8">
            <TextBlock Text="{Binding Label}" Style="{StaticResource PanelTitle}" FontSize="12" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Faint}" Margin="0,2,0,0" Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
            <Rectangle Height="1" Fill="{StaticResource SubtleLineBrush}" Margin="0,5,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NoteField}">
        <Border x:Name="Box" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Background="{StaticResource PanelHeaderBrush}" BorderThickness="1" BorderBrush="{StaticResource SubtleLineBrush}">
            <StackPanel>
                <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                <ui:Button Content="{Binding ActionLabel}" Command="{Binding Action}" Margin="0,8,0,0" Padding="10,3"
                           Visibility="{Binding ActionLabel, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                <Setter TargetName="Box" Property="Background" Value="#22EFCB4A" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActionField}">
        <ui:Button x:Name="Button" Content="{Binding ButtonText}" Command="{Binding Action}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                <Setter TargetName="Button" Property="Appearance" Value="Primary" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <ui:TextBox x:Name="Box" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Placeholder}" ClearButtonEnabled="False"
                        inf:Behaviors.CommitOnEnter="True" />
        </ContentControl>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Multiline}" Value="True">
                <Setter TargetName="Box" Property="AcceptsReturn" Value="True" />
                <Setter TargetName="Box" Property="TextWrapping" Value="Wrap" />
                <Setter TargetName="Box" Property="MinHeight" Value="64" />
                <Setter TargetName="Box" Property="VerticalContentAlignment" Value="Top" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TranslatableTextField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <StackPanel>
                <ui:TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" ClearButtonEnabled="False" inf:Behaviors.CommitOnEnter="True"
                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top"
                            PlaceholderText="{Binding Placeholder}" />
                <CheckBox IsChecked="{Binding UseKey}" Content="Translation key (i18n)" FontSize="12" Margin="0,4,0,0"
                          ToolTip="Store a key into i18n/default.json instead of the text, for translated packs." />
            </StackPanel>
        </ContentControl>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UseKey}" Value="True">
                <Setter TargetName="Box" Property="AcceptsReturn" Value="False" />
                <Setter TargetName="Box" Property="MinHeight" Value="0" />
                <Setter TargetName="Box" Property="PlaceholderText" Value="key in i18n/default.json" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NumberField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Suffix}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding Suffix, Converter={StaticResource VisibleWhen}}" />
                    <ui:NumberBox Style="{StaticResource FieldNumber}" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SmallChange="{Binding Step}" LargeChange="{Binding Step}" />
                </DockPanel>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Faint}" Margin="0,2,0,0" Visibility="{Binding Hint, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BoolField}">
        <StackPanel Margin="0,0,0,10">
            <CheckBox IsChecked="{Binding Value}" Content="{Binding Label}" ToolTip="{Binding Help}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Faint}" Margin="28,0,0,0" Visibility="{Binding Description, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Problem}" Style="{StaticResource ProblemText}" Foreground="{Binding ProblemIsError, Converter={StaticResource SeverityBrush}}"
                       Visibility="{Binding Problem, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ChoiceItemTemplate" DataType="{x:Type vm:ChoiceItem}">
        <StackPanel Orientation="Horizontal">
            <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,6,0" Style="{StaticResource Pixel}"
                   Visibility="{Binding Image, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Label}" />
            <TextBlock Text="{Binding Detail, StringFormat='  ·  {0}'}" Style="{StaticResource Faint}" TextWrapping="NoWrap" VerticalAlignment="Center"
                       Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChoiceField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <Grid>
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" IsEditable="{Binding IsEditable}"
                          Text="{Binding Text, UpdateSourceTrigger=LostFocus}" TextSearch.TextPath="Label" IsTextSearchEnabled="True"
                          ItemTemplate="{StaticResource ChoiceItemTemplate}" inf:Behaviors.CommitOnEnter="True" HorizontalAlignment="Stretch"
                          Visibility="{Binding IsLong, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <!-- Long fixed lists (a modded game's 200+ characters): search instead of scrolling. -->
                <views:SearchablePicker ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Noun="choices"
                                        Visibility="{Binding IsLong, Converter={StaticResource VisibleWhen}}" />
            </Grid>
        </ContentControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TileField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="X" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ui:NumberBox Grid.Column="1" Style="{StaticResource FieldNumber}" Value="{Binding X, Mode=TwoWay}" Minimum="0" Maximum="999" MinWidth="70" />
                    <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <ui:NumberBox Grid.Column="3" Style="{StaticResource FieldNumber}" Value="{Binding Y, Mode=TwoWay}" Minimum="0" Maximum="999" MinWidth="70" />
                    <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Location24}" Command="{Binding PickCommand}" Margin="6,0,0,0" Padding="8,5"
                               ToolTip="Pick the tile on the stage" Visibility="{Binding PickCommand, Converter={StaticResource VisibleWhen}}" />
                </Grid>
                <Grid Margin="0,6,0,0" Visibility="{Binding HasPixels, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nudge (px)" Style="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:NumberBox Grid.Column="1" Style="{StaticResource FieldNumber}" Value="{Binding PxX, Mode=TwoWay}" Minimum="-64" Maximum="64" MinWidth="60" Margin="0,0,4,0" />
                    <ui:NumberBox Grid.Column="2" Style="{StaticResource FieldNumber}" Value="{Binding PxY, Mode=TwoWay}" Minimum="-64" Maximum="64" MinWidth="60" />
                </Grid>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ItemField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="4" Background="{StaticResource StageBackdropBrush}" Margin="0,0,8,0">
                        <Image Source="{Binding Icon}" Style="{StaticResource Pixel}" Width="24" Height="24" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" Padding="10,5" />
                    <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" PlaceholderText="item ID, e.g. (O)128" ClearButtonEnabled="False" inf:Behaviors.CommitOnEnter="True" />
                </DockPanel>
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ListField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ListRowViewModel}">
                            <Border CornerRadius="6" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1"
                                    Padding="8,6,4,0" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding RemoveCommand}" ToolTip="Remove" FontSize="12" />
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ChevronUp24}" Command="{Binding MoveUpCommand}" ToolTip="Move up" FontSize="12"
                                                   Visibility="{Binding MoveUpCommand, Converter={StaticResource VisibleWhen}}" />
                                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ChevronDown24}" Command="{Binding MoveDownCommand}" ToolTip="Move down" FontSize="12"
                                                   Visibility="{Binding MoveDownCommand, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Faint}" Margin="0,0,0,4" Visibility="{Binding Caption, Converter={StaticResource VisibleWhen}}" />
                                        <ItemsControl ItemsSource="{Binding Cells}" IsTabStop="False" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Faint}" Margin="0,0,0,6">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{x:Static inf:ListFieldEmpty.Instance}">
                            <Binding Path="Rows.Count" />
                            <Binding Path="EmptyText" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <ui:Button Content="{Binding AddLabel}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" Padding="10,4" />
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <!-- ================= Conditions (D-51): rows of pills, all or any, stored as the game's condition text ================= -->

    <Style x:Key="PillCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="MaxWidth" Value="230" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PillBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="inf:Behaviors.CommitOnEnter" Value="True" />
        <Setter Property="inf:Behaviors.SelectAllOnFocus" Value="True" />
    </Style>

    <DataTemplate DataType="{x:Type vm:ConditionRowViewModel}">
        <Border CornerRadius="6" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" Padding="8,6,2,0" Margin="0,0,0,6">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding RemoveCommand}"
                           ToolTip="Remove this condition" FontSize="11" VerticalAlignment="Top" />
                <StackPanel>
                    <WrapPanel>
                        <Border CornerRadius="10" Background="#22303F" BorderBrush="#3C5A7D" BorderThickness="1" Padding="9,3" Margin="0,0,6,6" VerticalAlignment="Center"
                                ToolTip="{Binding Category}">
                            <TextBlock Text="{Binding KindLabel}" FontSize="12.5" />
                        </Border>
                        <ComboBox Style="{StaticResource PillCombo}" ItemsSource="{Binding SubjectOptions}" SelectedItem="{Binding Subject}" DisplayMemberPath="Label"
                                  Visibility="{Binding SubjectIsShort, Converter={StaticResource VisibleWhen}}" />
                        <views:SearchablePicker Width="170" Margin="0,0,6,6" ItemsSource="{Binding SubjectOptions}" SelectedItem="{Binding Subject}" Noun="choices"
                                                Visibility="{Binding SubjectIsLong, Converter={StaticResource VisibleWhen}}" />
                        <ComboBox Style="{StaticResource PillCombo}" MinWidth="170" IsEditable="True" ItemsSource="{Binding SubjectOptions}" ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                  TextSearch.TextPath="Value" Text="{Binding SubjectValue, UpdateSourceTrigger=LostFocus}" inf:Behaviors.CommitOnEnter="True"
                                  ToolTip="Pick a flag the project uses, or type a new name" Visibility="{Binding SubjectIsTyped, Converter={StaticResource VisibleWhen}}" />
                        <ui:Button Content="{Binding ItemLabel}" Command="{Binding PickItemCommand}" Margin="0,0,6,6" Padding="9,3" FontSize="12.5"
                                   Visibility="{Binding SubjectIsItem, Converter={StaticResource VisibleWhen}}" />
                        <ComboBox Style="{StaticResource PillCombo}" ItemsSource="{Binding CompareOptions}" SelectedItem="{Binding Compare}" DisplayMemberPath="Label"
                                  Visibility="{Binding HasCompare, Converter={StaticResource VisibleWhen}}" />
                        <ComboBox Style="{StaticResource PillCombo}" ItemsSource="{Binding ValueOptions}" SelectedItem="{Binding ValueChoice}" DisplayMemberPath="Label"
                                  Visibility="{Binding HasValueOptions, Converter={StaticResource VisibleWhen}}" />
                        <TextBox Style="{StaticResource PillBox}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Hint}"
                                 Visibility="{Binding HasValueText, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="and" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,6" Visibility="{Binding IsBetween, Converter={StaticResource VisibleWhen}}" />
                        <TextBox Style="{StaticResource PillBox}" Text="{Binding Value2, UpdateSourceTrigger=LostFocus}" Visibility="{Binding IsBetween, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,6" Visibility="{Binding HasUnit, Converter={StaticResource VisibleWhen}}" />
                    </WrapPanel>
                    <TextBox Text="{Binding Raw, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,6,6"
                             inf:Behaviors.CommitOnEnter="True" ToolTip="The game's condition text (a game state query)"
                             Visibility="{Binding IsRaw, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Faint}" Margin="0,0,0,6" Visibility="{Binding Hint, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ConditionGroupViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding HasSeveral, Converter={StaticResource VisibleWhen}}">
                <ToggleButton Style="{StaticResource ToolbarToggle}" Content="all" IsChecked="{Binding IsAll}" ToolTip="Every condition must be true" />
                <ToggleButton Style="{StaticResource ToolbarToggle}" Content="any" IsChecked="{Binding IsAny}" ToolTip="One true condition is enough" />
                <TextBlock Text="of these are true" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False" />
            <Grid HorizontalAlignment="Left" Margin="0,0,0,4">
                <ComboBox ItemsSource="{Binding AddOptions}" SelectedItem="{Binding AddChoice}" ItemTemplate="{StaticResource ChoiceItemTemplate}"
                          MinWidth="210" ToolTip="Add a condition: hearts, a story flag, the season, an item…" />
                <TextBlock Text="＋ Add a condition…" IsHitTestVisible="False" Margin="12,0,30,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Expander Header="As a game query" Margin="0,2,0,0" Padding="0,4,0,0" ToolTip="The same conditions as the game's own text. Paste one here, or edit it.">
                <TextBox Text="{Binding QueryText, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" inf:Behaviors.CommitOnEnter="True" />
            </Expander>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ConditionGroupField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <StackPanel>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Faint}" Margin="0,0,0,6"
                           Visibility="{Binding Group.HasRows, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                <ContentPresenter Content="{Binding Group}" />
            </StackPanel>
        </ContentControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CheckCaseViewModel}">
        <Border CornerRadius="8" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" Padding="10,8,6,8" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveUpCommand}" ToolTip="Check this case earlier" FontSize="11" />
                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}" ToolTip="Remove this case" FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ContentPresenter Content="{Binding Group}" />
                <DockPanel Margin="0,6,4,0">
                    <TextBlock Text="then go to" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding Target}" ItemTemplate="{StaticResource ChoiceItemTemplate}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CheckField}">
        <ContentControl Style="{StaticResource FieldFrame}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Cases}" IsTabStop="False" />
                <ui:Button Content="Add a case" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCaseCommand}" Padding="10,4" Margin="0,0,0,8"
                           ToolTip="Another set of conditions, checked when the ones above aren't true" />
                <Border CornerRadius="8" Background="{StaticResource PanelHeaderBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" Padding="10,8">
                    <DockPanel>
                        <TextBlock Text="Otherwise" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding OtherwiseOptions}" SelectedItem="{Binding Otherwise}" ItemTemplate="{StaticResource ChoiceItemTemplate}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>
