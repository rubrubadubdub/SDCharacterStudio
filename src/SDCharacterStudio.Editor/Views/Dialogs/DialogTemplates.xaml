<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
                    xmlns:views="clr-namespace:SDCharacterStudio.Editor.Views"
                    xmlns:inf="clr-namespace:SDCharacterStudio.Editor.Infrastructure">

    <DataTemplate DataType="{x:Type vm:DependenciesViewModel+UseLink}">
        <ui:Button Command="{Binding Go}" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,2">
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="460" FontSize="12" />
        </ui:Button>
    </DataTemplate>

    <Style x:Key="DialogLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="Footer" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SubtleLineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="20,12" />
    </Style>
    <Style x:Key="ErrorBox" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Visibility" Value="{Binding Error, Converter={StaticResource VisibleWhen}}" />
        <Setter Property="Text" Value="{Binding Error}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SubtleLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!-- ===================== New project ===================== -->
    <DataTemplate DataType="{x:Type vm:NewProjectViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <ui:Button Content="Create" Appearance="Primary" Command="{Binding CreateCommand}" IsDefault="True" MinWidth="110" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,8,24,18">
                    <TextBlock Text="A pack holds one or more cutscenes. You can add more any time." Style="{StaticResource Caption}" />
                    <TextBlock Text="Pack name" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Robin's Summer" />
                    <TextBlock Text="Your name (author)" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="First cutscene" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding FirstScene, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="What happens, e.g. Robin asks for help" />
                    <TextBlock Text="Where it happens" Style="{StaticResource DialogLabel}" />
                    <views:SearchablePicker ItemsSource="{Binding Locations}" SelectedValue="{Binding Location}" Noun="locations" />
                    <Expander Header="Advanced" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="Unique ID (what SMAPI calls the pack)" Style="{StaticResource DialogLabel}" />
                            <ui:TextBox Text="{Binding UniqueId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Projects folder" Style="{StaticResource DialogLabel}" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                                <ui:TextBox Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock Style="{StaticResource Faint}" Margin="0,12,0,0" TextWrapping="Wrap">
                        <Run Text="The pack will be created in" /><LineBreak /><Run Text="{Binding FolderPreview, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ErrorBox}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Dependencies ===================== -->
    <DataTemplate DataType="{x:Type vm:DependenciesViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <DockPanel>
                    <TextBlock Text="Export writes these into manifest.json and studio.json." Style="{StaticResource Faint}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                        <ui:Button Content="Apply" Appearance="Primary" Command="{Binding ApplyCommand}" IsDefault="True" MinWidth="110" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,8,24,18">
                    <TextBlock Style="{StaticResource Caption}"
                               Text="The editor works out which other mods your pack needs from what your scenes use: characters, maps, items and sprites that mods add." />
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{StaticResource WarningBrush}"
                            Visibility="{Binding HasCatalog, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                        <TextBlock Style="{StaticResource Caption}" Text="There's no game export, so the editor can't tell which mod adds what. Load a save in the game with the SDCS Bridge, then open this again." />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding NothingNeeded, Converter={StaticResource VisibleWhen}}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource GoodBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Everything your scenes use comes with the game. No dependencies needed." VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Providers -->
                    <TextBlock Text="Mods your pack uses" Style="{StaticResource SectionTitle}" Visibility="{Binding Providers.Count, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DependenciesViewModel+ProviderRow}">
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="200">
                                            <ui:ToggleSwitch IsChecked="{Binding OnlySomeScenes}" Content="Only some scenes need it" />
                                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Faint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding ModId, Mode=OneWay, StringFormat='   {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal" FontSize="11" /></TextBlock>
                                            <ItemsControl ItemsSource="{Binding UseLinks}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Scenes}" Style="{StaticResource Faint}" Margin="0,4,0,0" />
                                            <TextBlock Text="The export wasn't sure this mod adds it (another mod may replace it)." Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" Visibility="{Binding Uncertain, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Unknown -->
                    <TextBlock Text="Which mod adds these?" Style="{StaticResource SectionTitle}" Visibility="{Binding Unknown.Count, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Unknown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DependenciesViewModel+UnknownRow}">
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="260" Margin="12,0,0,0" ItemsSource="{Binding Mods}" SelectedValuePath="Value" SelectedValue="{Binding Provider}"
                                                  DisplayMemberPath="Label" IsTextSearchEnabled="True" TextSearch.TextPath="Label" />
                                        <ItemsControl ItemsSource="{Binding UseLinks}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Edited by -->
                    <TextBlock Text="Changed by mods (no dependency)" Style="{StaticResource SectionTitle}" Visibility="{Binding Editors.Count, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Style="{StaticResource Faint}" Margin="0,-4,0,8" Text="Without these mods, these assets look like vanilla. Your scenes still work."
                               Visibility="{Binding Editors.Count, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Editors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DependenciesViewModel+EditorRow}">
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AddOptional}" Content="List as optional" Margin="12,0,0,0" VerticalAlignment="Top"
                                                  ToolTip="Adds an optional dependency so SMAPI loads that mod first. Nothing breaks without it." />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding UseLinks}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Missing -->
                    <TextBlock Text="Not found in your game" Style="{StaticResource SectionTitle}" Foreground="{StaticResource ErrorBrush}" Visibility="{Binding Missing.Count, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Missing}" />

                    <!-- Manual -->
                    <TextBlock Text="Extra dependencies" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Faint}" Margin="0,-4,0,8" Text="For anything the editor can't see, like a mod your dialogue mentions or a framework another mod needs." />
                    <ItemsControl ItemsSource="{Binding Manual}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DependenciesViewModel+ManualRow}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox IsEditable="True" Text="{Binding Mod, UpdateSourceTrigger=LostFocus}" IsTextSearchEnabled="True"
                                              ItemsSource="{Binding DataContext.InstalledMods, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              DisplayMemberPath="Value" ToolTip="The mod's UniqueID" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsRequired}" Content="Required" Margin="10,0" />
                                    <ui:TextBox Grid.Column="2" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Why (shown to players)" />
                                    <ui:Button Grid.Column="3" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" Margin="6,0,0,0"
                                               Command="{Binding DataContext.RemoveManualCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="Add a dependency" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddManualCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Pack settings ===================== -->
    <DataTemplate DataType="{x:Type vm:PackSettingsViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,4,24,18">
                    <TextBlock Text="Name" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Display name (shown in the game's config menus)" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Author" Style="{StaticResource DialogLabel}" />
                            <ui:TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Version" Style="{StaticResource DialogLabel}" />
                            <ui:TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Description" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                    <TextBlock Text="Unique ID" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding UniqueId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding IdChanged, Converter={StaticResource VisibleWhen}}"
                               Text="A new ID makes this a different mod to SMAPI and the game: players who already saw these scenes will see them again, and other packs that depend on this one must be updated." />
                    <TextBlock Style="{StaticResource Faint}" Margin="0,12,0,0"><Run Text="Pack folder: " /><Run Text="{Binding PackFolder, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource ErrorBox}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Settings ===================== -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,4,24,18">
                    <TextBlock Text="GAME EXPORT" Style="{StaticResource SectionTitle}" Margin="0,8,0,4" />
                    <TextBlock Text="Export folder (the SDCS Bridge writes it; see its config)" Style="{StaticResource DialogLabel}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseExportCommand}" Margin="6,0,0,0" />
                        <ui:TextBox Text="{Binding ExportFolder, UpdateSourceTrigger=LostFocus}" inf:Behaviors.CommitOnEnter="True" />
                    </DockPanel>
                    <TextBlock Text="Profile (one per game setup the Bridge exported)" Style="{StaticResource DialogLabel}" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChoiceItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Detail, StringFormat='  ·  {0}'}" Style="{StaticResource Faint}" TextWrapping="NoWrap" VerticalAlignment="Center"
                                               Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="FOLDERS" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                    <TextBlock Text="Stardew Valley's Mods folder (for Export › copy into Mods)" Style="{StaticResource DialogLabel}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseModsCommand}" Margin="6,0,0,0" />
                        <ui:TextBox Text="{Binding ModsFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="…\Stardew Valley\Mods" />
                    </DockPanel>
                    <TextBlock Text="Where new projects go" Style="{StaticResource DialogLabel}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseProjectsCommand}" Margin="6,0,0,0" />
                        <ui:TextBox Text="{Binding ProjectsFolder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="YOU" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                    <TextBlock Text="Author name for new packs" Style="{StaticResource DialogLabel}" />
                    <ui:TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Video import ===================== -->
    <DataTemplate DataType="{x:Type vm:VideoImportViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <ui:Button Content="Import" Appearance="Primary" Command="{Binding ImportCommand}" IsDefault="True" MinWidth="110" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,4,24,18">
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="A video is a folder of same-size PNG frames, played full screen during a Video beat. The frames are copied into the pack." />
                    <TextBlock Text="Frames folder" Style="{StaticResource DialogLabel}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                        <ui:TextBox Text="{Binding SourceFolder, Mode=OneWay}" IsReadOnly="True" PlaceholderText="No folder chosen" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Left" Width="160" Height="90" CornerRadius="4" Background="{StaticResource StageBackdropBrush}" Margin="0,0,12,0">
                            <Image Source="{Binding Preview}" Style="{StaticResource Pixel}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Video ID (used by Video beats)" Style="{StaticResource DialogLabel}" />
                            <ui:TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Frames per second" Style="{StaticResource DialogLabel}" />
                            <ui:NumberBox Value="{Binding Fps, Mode=TwoWay}" Minimum="1" Maximum="60" MaxDecimalPlaces="1" SmallChange="1" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Sounds (play a cue when a frame shows)" Style="{StaticResource DialogLabel}" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding Sounds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VideoImportViewModel+SoundRow}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ui:NumberBox Grid.Column="1" Value="{Binding Frame, Mode=TwoWay}" Minimum="1" Maximum="9999" MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                                    <TextBlock Grid.Column="2" Text="cue" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                    <ui:TextBox Grid.Column="3" Text="{Binding Cue, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="sound cue, e.g. dwop" />
                                    <ui:Button Grid.Column="4" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" Margin="6,0,0,0"
                                               Command="{Binding DataContext.RemoveSoundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="Add a sound" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddSoundCommand}" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource ErrorBox}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Export ===================== -->
    <DataTemplate DataType="{x:Type vm:ExportViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Close" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <ui:Button Content="Export" Icon="{ui:SymbolIcon BoxArrowUp24}" Appearance="Primary" Command="{Binding ExportCommand}" IsDefault="True" MinWidth="120"
                               IsEnabled="{Binding HasErrors, Converter={StaticResource Not}}" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,6,24,18">
                    <!-- status -->
                    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Show problems" Command="{Binding ShowProblemsCommand}" VerticalAlignment="Center"
                                       Visibility="{Binding HasErrors, Converter={StaticResource VisibleWhen}}" />
                            <ui:SymbolIcon DockPanel.Dock="Left" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Symbol="{Binding HasErrors, Converter={x:Static inf:ExportIcons.Status}}"
                                           Foreground="{Binding HasErrors, Converter={x:Static inf:ExportIcons.StatusBrush}}" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Visibility="{Binding NoCatalog, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource Caption}" Text="No game export: names, maps and dependencies can't be checked against your game. The pack still exports." />
                    </Border>

                    <TextBlock Text="WHAT PLAYERS INSTALL" Style="{StaticResource SectionTitle}" />
                    <RadioButton GroupName="ExportTarget" IsChecked="{Binding IsCompleteMod}" Content="Just this mod (recommended)" />
                    <RadioButton GroupName="ExportTarget" IsChecked="{Binding IsCodeMod}" Content="My C# mod: export the scenes for it" Margin="0,4,0,0" />
                    <RadioButton GroupName="ExportTarget" IsChecked="{Binding IsContentPack}" Content="A content pack for the SDCharacterStudio framework" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding TargetText}" Margin="0,6,0,0" />
                    <StackPanel Visibility="{Binding IsContentPack, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                        <DockPanel Margin="0,6,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOutputCommand}" Margin="6,0,0,0" />
                            <ui:TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding OutputFolder}" />
                        </DockPanel>
                        <TextBlock Text="{Binding OutputHint}" Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" BorderBrush="{StaticResource WarningBrush}" Visibility="{Binding ShowsNeverPlays, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Show me" Command="{Binding ShowNeverPlaysCommand}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding NeverPlaysText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="THE PACK" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Export checks the pack, saves every file and fills in the dependencies in manifest.json and studio.json. The pack folder stays your source." />
                    <TextBlock Text="{Binding PackFolder}" Style="{StaticResource Faint}" Margin="0,4,0,0" />

                    <TextBlock Text="DEPENDENCIES" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Review…" Command="{Binding OpenDependenciesCommand}" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding DependencyText}" TextWrapping="Wrap" />
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsCodeMod, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                    <TextBlock Text="ALSO" Style="{StaticResource SectionTitle}" />
                    <CheckBox IsChecked="{Binding MakeZip}" Content="Make a zip to share" />
                    <DockPanel Margin="28,6,0,0" IsEnabled="{Binding MakeZip}">
                        <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseZipCommand}" Margin="6,0,0,0" />
                        <ui:TextBox Text="{Binding ZipPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <CheckBox IsChecked="{Binding CopyToMods}" Content="Copy into the game's Mods folder (to play it for real)" Margin="0,12,0,0" />
                    <DockPanel Margin="28,6,0,0" IsEnabled="{Binding CopyToMods}">
                        <ui:Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseModsCommand}" Margin="6,0,0,0" />
                        <ui:TextBox Text="{Binding ModsFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="…\Stardew Valley\Mods" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Faint}" Margin="28,4,0,0" Text="Restart the game afterwards; SMAPI loads mods at startup. Previews don't need this." />
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" BorderBrush="{StaticResource GoodBrush}" Visibility="{Binding Done, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenOutputCommand}" VerticalAlignment="Top" Margin="10,0,0,0" />
                                <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" />
                            </DockPanel>
                            <TextBlock Text="{Binding NextSteps}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource ErrorBox}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Item picker ===================== -->
    <DataTemplate DataType="{x:Type vm:ItemPickerViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
                <DockPanel>
                    <ui:TextBox Text="{Binding Manual, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="or type an item ID" Width="220" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                        <ui:Button Content="Choose" Appearance="Primary" Command="{Binding ChooseCommand}" IsDefault="True" MinWidth="110" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ui:TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search items" Icon="{ui:SymbolIcon Search24}" Margin="20,8,20,8" />
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="16,0,16,8" Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" inf:DialogBehaviors.ChooseOnDoubleClick="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ItemPickerViewModel+ItemOption}">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="32" Height="32" Style="{StaticResource Pixel}" Margin="0,0,10,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
