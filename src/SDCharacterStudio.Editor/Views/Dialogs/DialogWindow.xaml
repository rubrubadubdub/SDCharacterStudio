<ui:FluentWindow x:Class="SDCharacterStudio.Editor.Views.Dialogs.DialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="560" SizeToContent="Height" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round" ShowInTaskbar="False" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="/SDCharacterStudio.Editor;component/Views/Dialogs/DialogTemplates.xaml" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False" Height="34" />
        <ContentControl Grid.Row="1" Content="{Binding}" Focusable="False" />
    </Grid>
</ui:FluentWindow>
