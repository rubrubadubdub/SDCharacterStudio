<UserControl x:Class="SDCharacterStudio.Editor.Views.SearchablePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             x:Name="Root">
    <!-- A drop-down for long lists (hundreds of locations or characters): search by any part of the name or the mod,
         a visible scrollbar, arrows + Enter to pick, Esc to close. -->
    <UserControl.Resources>
        <ControlTemplate x:Key="PickerList" TargetType="ListBox">
            <ScrollViewer Style="{StaticResource VisibleScrollViewer}" Focusable="False" CanContentScroll="True"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="11,6,8,6" MinHeight="34"
                      IsChecked="{Binding IsOpen, ElementName=Popup, Mode=TwoWay}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Popup, Converter={StaticResource Not}}">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronDown24" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedLabel" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SelectedDetail" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </ToggleButton>
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               MinWidth="{Binding ActualWidth, ElementName=Toggle}" Opened="OnOpened" Closed="OnClosed">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="6" Margin="0,4,0,0" MinWidth="360">
                <StackPanel>
                    <ui:TextBox x:Name="Search" Icon="{ui:SymbolIcon Search24}" PlaceholderText="Search…" ClearButtonEnabled="True"
                                TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey" />
                    <ListBox x:Name="List" MaxHeight="380" Margin="0,6,0,0" BorderThickness="0" Background="Transparent" Template="{StaticResource PickerList}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonUp="OnListClick" PreviewKeyDown="OnSearchKey">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Detail, StringFormat='  ·  {0}'}" Style="{StaticResource Faint}" VerticalAlignment="Center"
                                               Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="Count" Style="{StaticResource Faint}" Margin="4,6,4,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
