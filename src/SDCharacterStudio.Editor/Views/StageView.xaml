<UserControl x:Class="SDCharacterStudio.Editor.Views.StageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:views="clr-namespace:SDCharacterStudio.Editor.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StageViewModel}"
             Focusable="True" KeyDown="Stage_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="8,6,8,6" LastChildFill="False">
            <TextBlock Text="Location" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <views:SearchablePicker Width="260" ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation}" Noun="locations"
                                    ToolTip="Where the cutscene happens" />
            <TextBlock Text="House" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,8,0"
                       Visibility="{Binding ShowHousePicker, Converter={StaticResource VisibleWhen}}" />
            <ComboBox Width="190" ItemsSource="{Binding HouseOptions}" SelectedItem="{Binding SelectedHouse}" DisplayMemberPath="Label"
                      Visibility="{Binding ShowHousePicker, Converter={StaticResource VisibleWhen}}"
                      ToolTip="Which farmhouse the stage shows: yours as the game export has it, or an upgraded one as mods make it. Players' houses differ: positions from the spouse's room follow the room." />
            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon PersonAdd24}" Content="Add player" Command="{Binding AddPlayerCommand}" Margin="8,0,0,0"
                       ToolTip="Put the player (farmer) on the stage" />
            <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon PaintBrush24}" Content="Draw outfits in the game" Command="{Binding RenderOutfitsCommand}" Margin="4,0,0,0"
                       Visibility="{Binding HasPendingOutfits, Converter={StaticResource VisibleWhen}}"
                       ToolTip="The player wears something the stage hasn't seen (the item icons above their head). With the game running, it draws them exactly; the stage remembers." />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowGrid}" Content="Grid" ToolTip="Tile grid" />
                <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowPassability}" Content="Walkable" ToolTip="Tint the tiles people can walk on" />
                <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowFront}" Content="Front" ToolTip="Front layer: roofs, tree tops (drawn over actors)" />
                <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding ShowCamera}" Content="Camera" ToolTip="The player's view at 1920×1080, 100% zoom" />
                <Rectangle Width="1" Height="18" Fill="{StaticResource SubtleLineBrush}" Margin="8,0" />
                <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomOut24}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-)" />
                <TextBlock Text="{Binding Zoom, Converter={StaticResource Percent}}" Width="44" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ZoomIn24}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl+=)" />
            </StackPanel>
        </DockPanel>

        <!-- Map edited by a mod -->
        <Border Grid.Row="1" Margin="8,0,8,6" Padding="10,6" CornerRadius="6" BorderThickness="1"
                Visibility="{Binding HasMapWarning, Converter={StaticResource VisibleWhen}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#33EFCB4A" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMapInfo}" Value="True">
                            <Setter Property="Background" Value="#225B9BF0" />
                            <Setter Property="BorderBrush" Value="#885B9BF0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="Warning24" />
                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMapInfo}" Value="True">
                                    <Setter Property="Symbol" Value="Info24" />
                                    <Setter Property="Foreground" Value="#FF8DBBF5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding DismissMapNoticeCommand}" Margin="6,0,0,0"
                           ToolTip="Hide this for this scene" />
                <ui:Button DockPanel.Dock="Right" Content="{Binding MapActionText}" Command="{Binding MapActionCommand}" Margin="8,0,0,0"
                           Visibility="{Binding MapActionText, Converter={StaticResource VisibleWhen}}"
                           ToolTip="A variant is a copy of this cutscene: the original plays only when the mod is installed, the copy only when it isn't. Restage the copy for the vanilla map." />
                <TextBlock Text="{Binding MapWarning}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <!-- Places the stage can't show where they are (D-52) -->
            <Border Margin="8,0,8,6" Padding="10,6" CornerRadius="6" Background="#225B9BF0" BorderBrush="#885B9BF0" BorderThickness="1"
                    Visibility="{Binding HasPlaceNotice, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" Foreground="#FF8DBBF5" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PlaceNotice}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                </DockPanel>
            </Border>
            <!-- Picking a tile -->
            <Border Margin="8,0,8,6" Padding="10,6" CornerRadius="6" Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="{Binding IsPicking, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelPickCommand}" />
                    <TextBlock Text="{Binding PickPrompt}" VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <!-- The moment the stage shows (D-50) -->
            <Border Margin="8,0,8,6" Padding="10,4" CornerRadius="6" Background="#1A7FE0A8" BorderBrush="#447FE0A8" BorderThickness="1"
                    Visibility="{Binding HasMoment, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Timeline24" Foreground="#FF7FE0A8" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ui:Button DockPanel.Dock="Right" Content="Show the start" Command="{Binding ShowStartCommand}" Margin="8,0,0,0" Padding="10,3"
                               ToolTip="Everyone back at their start tiles: dragging an actor there changes where they start" />
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="The stage shows the scene once this beat has played: actors where their walks left them, facing and dressed as the beats so far say. Dragging an actor who walked changes where that walk ends.">
                        <Run Text="{Binding MomentText, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- The stage -->
        <ScrollViewer x:Name="Scroller" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource StageBackdropBrush}" Focusable="False" AllowDrop="True"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel" DragOver="Stage_DragOver" Drop="Stage_Drop" DragLeave="Stage_DragLeave">
            <Canvas x:Name="Surface" Width="{Binding Width}" Height="{Binding Height}" Background="#0F1113" Margin="24"
                    MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp" LostMouseCapture="Surface_LostMouseCapture"
                    MouseRightButtonUp="Surface_MouseRightButtonUp" MouseDown="Surface_MouseDown" MouseUp="Surface_MouseUp" MouseLeave="Surface_MouseLeave">
                <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Canvas.LayoutTransform>

                <Image Source="{Binding Back}" Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource Pixel}" Stretch="Fill" IsHitTestVisible="False" />
                <Image Source="{Binding Passable}" Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource Pixel}" Stretch="Fill" Opacity="0.45" IsHitTestVisible="False"
                       Visibility="{Binding ShowPassability, Converter={StaticResource VisibleWhen}}" />
                <views:TileGrid Width="{Binding Width}" Height="{Binding Height}" Zoom="{Binding Zoom}" IsHitTestVisible="False"
                                Visibility="{Binding ShowGrid, Converter={StaticResource VisibleWhen}}" />

                <!-- Hovered tile -->
                <Rectangle x:Name="HoverTile" Width="16" Height="16" Stroke="#C0FFFFFF" Fill="#18FFFFFF" IsHitTestVisible="False" Visibility="Collapsed"
                           StrokeThickness="{Binding Zoom, Converter={StaticResource InverseScale}, ConverterParameter=1}" />

                <!-- The selected beat's walks: a faint copy where each walk starts, and its path (D-50) -->
                <ItemsControl ItemsSource="{Binding Paths}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StagePathViewModel}">
                            <Canvas>
                                <Polyline Points="{Binding Points}" Stroke="#CC7FE0A8" StrokeDashArray="3 2" StrokeLineJoin="Round"
                                          StrokeThickness="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=2}" />
                                <Ellipse Width="4" Height="4" Fill="#CC7FE0A8" Canvas.Left="{Binding EndX}" Canvas.Top="{Binding EndY}">
                                    <Ellipse.RenderTransform><TranslateTransform X="-2" Y="-2" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Ghosts}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding TileLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding TileTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageActorViewModel}">
                            <Canvas Width="16" Height="16" Opacity="0.38">
                                <Rectangle Width="16" Height="16" Stroke="#AA7FE0A8" StrokeDashArray="2 1"
                                           StrokeThickness="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=1}" />
                                <Image Source="{Binding Sprite}" Canvas.Left="{Binding SpriteLeft}" Canvas.Top="{Binding SpriteTop}"
                                       Width="{Binding DrawWidth}" Height="{Binding DrawHeight}" Style="{StaticResource Pixel}" Stretch="Fill"
                                       RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding Flip, Converter={StaticResource Flip}}" />
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Items placed on the map by the beats so far (D-50) -->
                <ItemsControl ItemsSource="{Binding Props}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding TileLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding TileTop}" />
                            <Setter Property="Panel.ZIndex" Value="{Binding TileY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StagePropViewModel}">
                            <Canvas Width="16" Height="16" Tag="prop" Cursor="SizeAll" Background="Transparent" ToolTip="{Binding Note}">
                                <Canvas.RenderTransform>
                                    <TranslateTransform />
                                </Canvas.RenderTransform>
                                <Image Source="{Binding Image}" Canvas.Top="{Binding ImageTop}" Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource Pixel}" Stretch="Fill" />
                                <Rectangle x:Name="PropOutline" Canvas.Top="{Binding ImageTop}" Width="{Binding Width}" Height="{Binding Height}" Fill="Transparent" Stroke="#00000000"
                                           StrokeThickness="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=1.5}" />
                                <!-- no picture in the export: a token -->
                                <Border Width="16" Height="16" CornerRadius="2" Background="#AAE0B84A" Visibility="{Binding HasImage, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                                    <ui:SymbolIcon Symbol="Box24" FontSize="10" Foreground="White" />
                                </Border>
                            </Canvas>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="PropOutline" Property="Stroke" Value="#E07FE0A8" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Actors (positioned at their tiles; sprites drawn relative to the tile) -->
                <ItemsControl ItemsSource="{Binding Actors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding TileLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding TileTop}" />
                            <Setter Property="Panel.ZIndex" Value="{Binding TileY}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageActorViewModel}">
                            <Canvas Width="16" Height="16" Tag="actor" Cursor="SizeAll" Background="Transparent">
                                <Canvas.RenderTransform>
                                    <TranslateTransform />
                                </Canvas.RenderTransform>
                                <!-- tile highlight -->
                                <Rectangle x:Name="TileMark" Width="16" Height="16" Fill="#00000000" Stroke="#00000000"
                                           StrokeThickness="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=1.5}" />
                                <!-- sprite -->
                                <Image x:Name="Sprite" Source="{Binding Sprite}" Canvas.Left="{Binding SpriteLeft}" Canvas.Top="{Binding SpriteTop}"
                                       Width="{Binding DrawWidth}" Height="{Binding DrawHeight}" Style="{StaticResource Pixel}" Stretch="Fill"
                                       RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding Flip, Converter={StaticResource Flip}}" />
                                <!-- selection outline around the whole sprite -->
                                <Rectangle x:Name="Outline" Canvas.Left="{Binding SpriteLeft}" Canvas.Top="{Binding SpriteTop}" Width="{Binding DrawWidth}" Height="{Binding DrawHeight}"
                                           Stroke="#00000000" IsHitTestVisible="False"
                                           StrokeThickness="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=1.5}" />
                                <!-- costume items the game hasn't drawn yet, as icons over the head (D-49) -->
                                <ItemsControl ItemsSource="{Binding Badges}" Canvas.Left="{Binding SpriteLeft}" Canvas.Top="{Binding SpriteTop}" IsHitTestVisible="False"
                                              Visibility="{Binding HasBadges, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl.RenderTransform><TranslateTransform X="8" Y="2" /></ItemsControl.RenderTransform>
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#CC000000" CornerRadius="1" Margin="0,0,0.5,0" Padding="0.5">
                                                <Image Source="{Binding}" Width="7" Height="7" Style="{StaticResource Pixel}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- no sprite: a token -->
                                <Border Canvas.Left="1" Canvas.Top="-14" Width="14" Height="28" CornerRadius="7" Background="#AA5B9BF0" BorderBrush="#FFFFFFFF" BorderThickness="0.5"
                                        Visibility="{Binding HasSprite, Converter={StaticResource VisibleWhen}, ConverterParameter=not}">
                                    <TextBlock Text="{Binding Initial}" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Canvas.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding TileX, Mode=OneWay, StringFormat=' at {0},'}" /><Run Text="{Binding TileY, Mode=OneWay, StringFormat=' {0}'}" />
                                        <LineBreak />
                                        <Run Text="{Binding Outfit, Mode=OneWay, StringFormat='At this beat: {0}'}" />
                                        <LineBreak />
                                        <Run Text="{Binding PlaceNote, Mode=OneWay}" />
                                        <LineBreak />
                                        <Run Text="Drag to move (hold Alt for 1-pixel steps). Double-click or click the arrow to turn." Foreground="#A0FFFFFF" />
                                    </TextBlock>
                                </Canvas.ToolTip>
                            </Canvas>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInvolved}" Value="True">
                                    <Setter TargetName="TileMark" Property="Fill" Value="#40EFCB4A" />
                                    <Setter TargetName="Outline" Property="Stroke" Value="#CCEFCB4A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="TileMark" Property="Fill" Value="#404CB07A" />
                                    <Setter TargetName="Outline" Property="Stroke" Value="#E07FE0A8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="Sprite" Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Image Source="{Binding Front}" Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource Pixel}" Stretch="Fill" Opacity="0.8" IsHitTestVisible="False"
                       Visibility="{Binding ShowFront, Converter={StaticResource VisibleWhen}}" />


                <!-- Name tags and facing handles, above the front layer so roofs and trees never hide them -->
                <ItemsControl ItemsSource="{Binding Actors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding TileLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding TileTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageActorViewModel}">
                            <Canvas Width="16" Height="16" Background="{x:Null}">
                                <!-- name + facing handle under the feet -->
                                <Border x:Name="NameTag" Canvas.Top="16.5" CornerRadius="1.5" Background="#CC000000"
                                        Padding="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=3}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}" />
                                    </Border.InputBindings>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FacingArrow}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Cursor="Hand"
                                                   FontSize="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=11}"
                                                   ToolTip="Facing. Click to turn.">
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding TurnCommand}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Label}" Foreground="White"
                                                   FontSize="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=11}"
                                                   Margin="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=3}" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="NameTag" Property="Background" Value="#E0306E50" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Markers for the selected beat -->
                <ItemsControl ItemsSource="{Binding Markers}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageMarkerViewModel}">
                            <Canvas Width="16" Height="16">
                                <Rectangle Width="16" Height="16" Fill="#4045C08A" Stroke="#45C08A" StrokeDashArray="2 1"
                                           StrokeThickness="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=1.5}" />
                                <Border Canvas.Top="-0.5" Canvas.Left="17" Background="#CC000000" CornerRadius="1.5"
                                        Padding="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=3}">
                                    <TextBlock Text="{Binding Label}" Foreground="#7FE0A8"
                                               FontSize="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScale}, ConverterParameter=11}" />
                                </Border>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Camera frame (drag its tab to move the camera) -->
                <Canvas x:Name="CameraLayer" Canvas.Left="{Binding CameraRect.X}" Canvas.Top="{Binding CameraRect.Y}"
                        Visibility="{Binding ShowCamera, Converter={StaticResource VisibleWhen}}">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="CameraDrag" />
                    </Canvas.RenderTransform>
                    <Rectangle Width="{Binding CameraRect.Width}" Height="{Binding CameraRect.Height}" Stroke="#E6FFFFFF" StrokeDashArray="6 3" IsHitTestVisible="False"
                               StrokeThickness="{Binding Zoom, Converter={StaticResource InverseScale}, ConverterParameter=1.5}" />
                    <Border x:Name="CameraTab" Canvas.Left="0" Background="#E6FFFFFF" CornerRadius="0,0,2,0" Cursor="SizeAll"
                            Padding="{Binding Zoom, Converter={StaticResource InverseScale}, ConverterParameter=4}"
                            MouseLeftButtonDown="CameraTab_MouseLeftButtonDown" MouseMove="CameraTab_MouseMove" MouseLeftButtonUp="CameraTab_MouseLeftButtonUp" LostMouseCapture="CameraTab_LostMouseCapture"
                            ToolTip="What the player sees at 1920×1080 and 100% zoom. Drag to move the camera.">
                        <TextBlock Foreground="#1B1B1B" FontWeight="SemiBold"
                                   FontSize="{Binding Zoom, Converter={StaticResource InverseScale}, ConverterParameter=11}">
                            <Run Text="Camera" /><Run Text="{Binding CameraFollows, Mode=OneWay, Converter={x:Static views:StageView.FollowsText}}" />
                        </TextBlock>
                    </Border>
                </Canvas>
            </Canvas>
        </ScrollViewer>

        <!-- Empty / no map -->
        <Border Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,36" MaxWidth="460" Padding="14,10" CornerRadius="8"
                Background="#E61E2024" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" IsHitTestVisible="False"
                Visibility="{Binding EmptyText, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextAlignment="Center" />
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="10,4,10,5">
            <TextBlock DockPanel.Dock="Right" Text="{Binding HoverText}" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
            <TextBlock Style="{StaticResource Faint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="Drag characters and items from the left onto a tile · drag actors to move (Alt = 1 px) · double-click to turn · right-click a tile for “walks here” · Ctrl+wheel zooms" />
        </DockPanel>
    </Grid>
</UserControl>
