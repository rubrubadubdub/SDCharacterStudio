<UserControl x:Class="SDCharacterStudio.Editor.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SDCharacterStudio.Editor.ViewModels"
             xmlns:views="clr-namespace:SDCharacterStudio.Editor.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Border Style="{StaticResource Panel}" Background="{StaticResource StageBackdropBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="980" Margin="40,36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- Start -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Image Source="pack://application:,,,/SDCharacterStudio.Editor;component/Assets/app-256.png" Width="56" Height="56" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SDCharacterStudio" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Make Stardew Valley cutscenes: stage them, write them, preview them in the game." Style="{StaticResource Caption}" FontSize="13" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="START" Style="{StaticResource PanelTitle}" Margin="0,26,0,8" />
                    <ui:CardAction Icon="{ui:SymbolIcon DocumentAdd24}" Command="{Binding NewProjectCommand}" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="New project" FontWeight="SemiBold" />
                            <TextBlock Text="A new cutscene pack with its first scene, ready to stage." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardAction>
                    <ui:CardAction Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenProjectCommand}" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Open project…" FontWeight="SemiBold" />
                            <TextBlock Text="An .sdcs project you made before." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardAction>
                    <ui:CardAction Icon="{ui:SymbolIcon Box24}" Command="{Binding OpenPackFolderCommand}" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Open a pack folder…" FontWeight="SemiBold" />
                            <TextBlock Text="Any SDCS content pack (the folder with studio.json), even one written by hand." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardAction>

                    <TextBlock Text="RECENT" Style="{StaticResource PanelTitle}" Margin="0,22,0,6" Visibility="{Binding RecentProjects.Count, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Style="{StaticResource LinkButton}" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="6,4" ToolTip="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Converter={x:Static views:WelcomeView.FileTitle}}" FontSize="13" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Game connection -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="YOUR GAME" Style="{StaticResource PanelTitle}" Margin="0,8,0,8" />
                    <Border Style="{StaticResource Panel}" Padding="16,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <ui:SymbolIcon DockPanel.Dock="Left" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top"
                                               Symbol="{Binding HasCatalog, Converter={x:Static views:StatusIcons.Catalog}}"
                                               Foreground="{Binding HasCatalog, Converter={x:Static views:StatusIcons.CatalogBrush}}" />
                                <TextBlock Text="{Binding CatalogStatus}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                                       Text="The editor shows your real game: characters, maps, items and mod content (SVE, Ridgeside, East Scarp…). It reads them from an export the SDCS Bridge writes." />
                            <TextBlock Text="To export or refresh:" FontWeight="SemiBold" Margin="0,10,0,4" />
                            <TextBlock Style="{StaticResource Caption}" Text="1.  Install SDCharacterStudio and the SDCS Bridge in the game's Mods folder." />
                            <TextBlock Style="{StaticResource Caption}" Text="2.  Start the game and load a save. The Bridge exports once, the first time; the editor picks it up when it's done." />
                            <TextBlock Style="{StaticResource Caption}" Text="3.  After adding or updating mods: Preview › Ask the game to export again. It never re-exports by itself." />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ui:Button Content="Reload" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding LoadCatalogCommand}" Margin="0,0,6,0" />
                                <ui:Button Content="Settings…" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource SubtleLineBrush}" Margin="0,16,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding Bridge.State, Converter={StaticResource BridgeBrush}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Bridge.Text}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="17,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                       Text="{Binding Bridge.Note}" Visibility="{Binding Bridge.Note, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Style="{StaticResource Faint}" Margin="17,2,0,0" Text="Preview needs the game running with a save loaded." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
