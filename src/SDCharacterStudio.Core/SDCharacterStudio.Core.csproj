<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core must remain game-independent: no Stardew Valley, SMAPI, or MonoGame references. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Match the SMAPI projects' embedded symbols so deployment contains only our DLLs. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- SMAPI provides JSON at runtime; standalone consumers reference it explicitly. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
